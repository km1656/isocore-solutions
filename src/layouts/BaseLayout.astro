---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Isocore Solutions | Enterprise Identity & Access Management",
  description = "Enterprise Identity & Access Management engineering, modernization, implementation, and support.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#061426" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>