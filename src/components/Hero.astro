---
import IdentityGateway from "./IdentityGateway.astro";

import Eyebrow from "./Eyebrow.astro";

---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
  <div class="hero-glow hero-glow-two" aria-hidden="true"></div>

  <div class="hero-inner">

    <!-- HERO COPY -->

    <div class="hero-copy">

      <!-- <Eyebrow
  variant="bracket"
  text="Enterprise Identity Engineering"
/> -->

      <h1>
        Secure access.
        <span class="text-gradient">
          Modern identity.
        </span>
      </h1>

      <p class="hero-description">
        Isocore Solutions helps enterprise organizations
        design, implement, modernize, and manage Identity &
        Access Management across cloud, hybrid, and
        on-premises environments.
      </p>

      <div class="hero-actions">
        <a
          href="/contact"
          class="button button-primary"
        >
          <span>Schedule an IAM Assessment</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="/services"
          class="button button-secondary"
        >
          Explore Our Services
        </a>
      </div>

      <div
        class="hero-meta"
        aria-label="Core capabilities"
      >
        <span>IAM Architecture</span>
        <span>Cloud &amp; Hybrid Identity</span>
        <span>Directory Modernization</span>
      </div>

    </div>


    <!-- HERO VISUAL -->

    <div class="hero-visual">

      <div
        class="hero-visual-halo"
        aria-hidden="true"
      ></div>

      <IdentityGateway />

      <div
        class="visual-label visual-label-top"
        aria-hidden="true"
      >
        <span></span>
        Identity Layer
      </div>

      <div
        class="visual-label visual-label-bottom"
        aria-hidden="true"
      >
        <span></span>
        Secure Access
      </div>

    </div>

  </div>
</section>


<style>
  /* =================================
     HERO
     ================================= */

  .hero {
    position: relative;

    width: 100%;

    min-height: 85vh;
    display: flex;
    align-items: center;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 76% 45%,
        rgba(0, 180, 219, 0.075),
        transparent 30%
      ),
      radial-gradient(
        circle at 20% 80%,
        rgba(0, 114, 255, 0.045),
        transparent 30%
      ),
      var(--color-bg);
  }


  /* =================================
     HERO INNER
     
     THIS IS THE ACTUAL CONTAINER
     ================================= */

  .hero-inner {
    position: relative;

    z-index: 2;

    width: min(
      1320px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 0.9fr);

    align-items: center;

    gap: 56px;

    padding-block: 120px 80px;
  }


  /* =================================
     ARCHITECTURAL GRID
     ================================= */

  .hero-grid {
    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: 0.55;

    background-image:
      linear-gradient(
        rgba(25, 58, 89, 0.075) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(25, 58, 89, 0.075) 1px,
        transparent 1px
      );

    background-size: 64px 64px;

    mask-image:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.65),
        transparent 90%
      );

    -webkit-mask-image:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.65),
        transparent 90%
      );
  }


  /* =================================
     AMBIENT GLOWS
     ================================= */

  .hero-glow {
    position: absolute;

    border-radius: 50%;

    filter: blur(100px);

    pointer-events: none;
  }

  .hero-glow-one {
    width: 500px;
    height: 500px;

    top: 5%;
    right: 4%;

    background: var(--color-cyan);

    opacity: 0.055;
  }

  .hero-glow-two {
    width: 360px;
    height: 360px;

    left: -8%;
    bottom: -25%;

    background: var(--color-primary);

    opacity: 0.04;
  }


  /* =================================
     HERO COPY
     ================================= */

  .hero-copy {
    width: 100%;

    max-width: 620px;
  }


 .hero h1 {
  max-width: 800px;
  margin: 0 0 26px;

  color: var(--color-text);
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 5.5vw, 5.25rem);
  font-weight: 800;
  line-height: 1.01;
  letter-spacing: -0.055em;
  margin-bottom: 30px;
}


  .hero-description {
  max-width: 590px;
  font-size: 0.98rem;
  line-height: 1.75;
}


  /* =================================
     ACTIONS
     ================================= */

  .hero-actions {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 14px;
  }


  .hero-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 50px;

    padding: 0 21px;

    border-radius: var(--radius-sm);

    font-size: 0.84rem;

    font-weight: 700;

    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }


  .hero-button:hover {
    transform: translateY(-2px);
  }


  .hero-button-primary {
    gap: 11px;

    background: var(--color-primary);

    color: var(--color-white);

    box-shadow:
      0 8px 22px
      rgba(0, 114, 255, 0.16);
  }


  .hero-button-primary:hover {
    background: var(--color-primary-hover);

    box-shadow:
      0 10px 28px
      rgba(0, 114, 255, 0.22);
  }


  .hero-button-primary span:last-child {
    font-size: 1rem;

    line-height: 1;
  }


  .hero-button-secondary {
    border: 1px solid var(--color-border-strong);

    background: rgba(255, 255, 255, 0.7);

    color: var(--color-text);
  }


  .hero-button-secondary:hover {
    border-color: var(--color-primary);

    background: var(--color-white);
  }


  /* =================================
     META
     ================================= */

  .hero-meta {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 9px 22px;

    margin-top: 27px;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: 0.63rem;

    letter-spacing: 0.025em;
  }


  .hero-meta span {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    white-space: nowrap;
  }


  .hero-meta span::before {
    content: "";

    width: 5px;
    height: 5px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--color-cyan);
  }


  /* =================================
     HERO VISUAL
     ================================= */

  .hero-visual {
    position: relative;

    display: grid;

    place-items: center;

    width: 100%;

    min-height: 500px;
  }


  .hero-visual-halo {
    position: absolute;

    width: 430px;
    height: 430px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(0, 180, 219, 0.12),
        rgba(0, 114, 255, 0.035) 44%,
        transparent 72%
      );

    filter: blur(18px);

    pointer-events: none;
  }


  /* =================================
     VISUAL LABELS
     ================================= */

  .visual-label {
    position: absolute;

    display: flex;

    align-items: center;

    gap: 9px;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: 0.6rem;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .visual-label span {
    width: 6px;
    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--color-cyan);
  }


  .visual-label-top {
    top: 12%;
    right: 0;
  }


  .visual-label-bottom {
    bottom: 12%;
    left: 0;
  }


  /* =================================
     TABLET
     ================================= */

  @media (max-width: 1000px) {
    .hero {
      min-height: auto;
    }

    .hero-inner {
      grid-template-columns: 1fr;

      gap: 20px;

      padding-block: 120px 70px;
    }

    .hero-copy {
      max-width: 760px;
    }

    .hero-visual {
      min-height: 440px;
    }
  }


  /* =================================
     MOBILE
     ================================= */

  @media (max-width: 700px) {
    .hero-inner {
      width: calc(100% - 40px);

      padding-block: 105px 60px;
    }

    .hero h1 {
      margin-bottom: 22px;

      font-size: clamp(
        2.8rem,
        13vw,
        4rem
      );

      line-height: 1;
    }

    .hero-description {
      margin-bottom: 28px;

      font-size: 0.96rem;

      line-height: 1.7;
    }

    .hero-actions {
      flex-direction: column;

      align-items: stretch;
    }

    .hero-button {
      width: 100%;
    }

    .hero-meta {
      gap: 9px 16px;

      margin-top: 24px;

      font-size: 0.59rem;
    }

    .hero-visual {
      min-height: 350px;
    }

    .hero-visual-halo {
      width: 320px;
      height: 320px;
    }

    .visual-label {
      display: none;
    }

    .hero-grid {
      background-size: 52px 52px;
    }
  }
  .hero-inner {
  width: min(1320px, calc(100% - 48px));
  margin-inline: auto;
}
</style>