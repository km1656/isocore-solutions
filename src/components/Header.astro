---
---

<header class="site-header">
  <div class="container header-inner">

    <!-- BRAND -->
    <a href="/" class="brand" aria-label="Isocore Solutions home">
      <img
        src="/images/isocore.svg"
        alt="Isocore Solutions"
        class="brand-logo"
      />
    </a>

    <!-- DESKTOP NAVIGATION -->
    <nav class="desktop-nav" aria-label="Main navigation">

      <a href="/">Home</a>

      <a href="/about">About</a>

      <!-- SERVICES DROPDOWN -->
      <div class="nav-dropdown">
        <button
          class="nav-dropdown-trigger"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Services</span>
          <span class="dropdown-arrow" aria-hidden="true">⌄</span>
        </button>

        <div class="nav-dropdown-menu">
          <a href="/services">
            <span class="dropdown-title">Services Overview</span>
            <span class="dropdown-description">
              Enterprise identity engineering
            </span>
          </a>

          <a href="/services/iam-strategy-architecture">
            <span class="dropdown-title">
              IAM Strategy & Architecture
            </span>
            <span class="dropdown-description">
              Identity strategy, architecture & roadmaps
            </span>
          </a>

          <a href="/services/identity-modernization">
            <span class="dropdown-title">
              Identity Modernization
            </span>
            <span class="dropdown-description">
              Modernize legacy identity infrastructure
            </span>
          </a>

          <a href="/services/implementation-integration">
            <span class="dropdown-title">
              Implementation & Integration
            </span>
            <span class="dropdown-description">
              Implement and connect identity platforms
            </span>
          </a>

          <a href="/services/managed-identity-support">
            <span class="dropdown-title">
              Managed Identity & Support
            </span>
            <span class="dropdown-description">
              Ongoing identity engineering & operations
            </span>
          </a>
        </div>
      </div>

      <a href="/platforms">Platforms</a>

      <a href="/insights">Insights</a>

      <a href="/contact">Contact</a>

    </nav>

    <!-- HEADER CTA -->
    <a href="/contact" class="button button-primary header-cta">
      <span>Schedule IAM Assessment</span>
      <span aria-hidden="true">→</span>
    </a>

    <!-- MOBILE TOGGLE -->
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">

    <nav aria-label="Mobile navigation">

      <a href="/">Home</a>

      <a href="/about">About</a>

      <!-- MOBILE SERVICES -->
      <div class="mobile-services">

        <button
          class="mobile-services-trigger"
          type="button"
          aria-expanded="false"
        >
          <span>Services</span>
          <span class="mobile-services-arrow" aria-hidden="true">
            ↓
          </span>
        </button>

        <div class="mobile-services-menu">

          <a href="/services">
            Services Overview
          </a>

          <a href="/services/iam-strategy-architecture">
            IAM Strategy & Architecture
          </a>

          <a href="/services/identity-modernization">
            Identity Modernization
          </a>

          <a href="/services/implementation-integration">
            Implementation & Integration
          </a>

          <a href="/services/managed-identity-support">
            Managed Identity & Support
          </a>

        </div>

      </div>

      <a href="/platforms">Platforms</a>

      <a href="/insights">Insights</a>

      <a href="/contact">Contact</a>

    </nav>

    <a href="/contact" class="button button-primary mobile-cta">
      <span>Schedule IAM Assessment</span>
      <span aria-hidden="true">→</span>
    </a>

  </div>
</header>

<script>
  const menuToggle =
    document.querySelector<HTMLButtonElement>(".menu-toggle");

  const mobileMenu =
    document.querySelector<HTMLElement>(".mobile-menu");

  const serviceDropdown =
    document.querySelector<HTMLElement>(".nav-dropdown");

  const serviceTrigger =
    document.querySelector<HTMLButtonElement>(
      ".nav-dropdown-trigger"
    );

  const mobileServices =
    document.querySelector<HTMLElement>(".mobile-services");

  const mobileServicesTrigger =
    document.querySelector<HTMLButtonElement>(
      ".mobile-services-trigger"
    );

  /*
   * Desktop Services dropdown
   */

  serviceTrigger?.addEventListener("click", () => {
    const isOpen =
      serviceTrigger.getAttribute("aria-expanded") === "true";

    serviceTrigger.setAttribute(
      "aria-expanded",
      String(!isOpen)
    );

    serviceDropdown?.classList.toggle(
      "is-open",
      !isOpen
    );
  });

  /*
   * Close desktop dropdown when clicking outside
   */

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    if (
      serviceDropdown &&
      !serviceDropdown.contains(target)
    ) {
      serviceDropdown.classList.remove("is-open");

      serviceTrigger?.setAttribute(
        "aria-expanded",
        "false"
      );
    }
  });

  /*
   * Mobile menu
   */

  menuToggle?.addEventListener("click", () => {
    const isOpen =
      menuToggle.getAttribute("aria-expanded") === "true";

    menuToggle.setAttribute(
      "aria-expanded",
      String(!isOpen)
    );

    menuToggle.setAttribute(
      "aria-label",
      isOpen
        ? "Open navigation"
        : "Close navigation"
    );

    mobileMenu?.classList.toggle(
      "is-open",
      !isOpen
    );

    menuToggle.classList.toggle(
      "is-open",
      !isOpen
    );
  });

  /*
   * Mobile Services dropdown
   */

  mobileServicesTrigger?.addEventListener(
    "click",
    () => {
      const isOpen =
        mobileServicesTrigger.getAttribute(
          "aria-expanded"
        ) === "true";

      mobileServicesTrigger.setAttribute(
        "aria-expanded",
        String(!isOpen)
      );

      mobileServices?.classList.toggle(
        "is-open",
        !isOpen
      );
    }
  );

  /*
   * Close mobile menu after navigation
   */

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {

      menuToggle?.setAttribute(
        "aria-expanded",
        "false"
      );

      menuToggle?.setAttribute(
        "aria-label",
        "Open navigation"
      );

      mobileMenu?.classList.remove(
        "is-open"
      );

      menuToggle?.classList.remove(
        "is-open"
      );
    });
  });
</script>

<style>
  /* =================================
     HEADER
  ================================= */

  .site-header {
    position: absolute;
    z-index: 100;

    top: 0;
    left: 0;

    width: 100%;

    border-bottom: 1px solid
      rgba(216, 229, 239, 0.9);

    background: rgba(255, 255, 255, 0.94);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    box-shadow:
      0 4px 20px rgba(6, 20, 38, 0.04);
  }

  /* =================================
     HEADER INNER
  ================================= */

  .header-inner {
    display: flex;
    align-items: center;

    min-height: 76px;

    gap: 32px;
  }

  /* =================================
     BRAND
  ================================= */

  .brand {
    display: flex;
    align-items: center;

    flex-shrink: 0;

    margin-right: auto;
  }

  .brand-logo {
    display: block;

    width: 180px;
    height: auto;

    max-width: none;
  }

  /* =================================
     DESKTOP NAVIGATION
  ================================= */

  .desktop-nav {
    display: flex;
    align-items: center;

    gap: 26px;
  }

  .desktop-nav > a,
  .nav-dropdown-trigger {
    position: relative;

    color: var(--color-text-secondary);

    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;

    white-space: nowrap;
  }

  .desktop-nav > a {
    padding-block: 8px;
  }

  .desktop-nav > a::after,
  .nav-dropdown-trigger::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: 0;

    width: 0;
    height: 2px;

    border-radius: 999px;

    background: var(--color-primary);

    transition:
      width var(--transition-fast);
  }

  .desktop-nav > a:hover,
  .nav-dropdown-trigger:hover {
    color: var(--color-text);
  }

  .desktop-nav > a:hover::after,
  .nav-dropdown-trigger:hover::after {
    width: 100%;
  }

  /* =================================
     SERVICES DROPDOWN
  ================================= */

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;

    gap: 6px;

    padding: 8px 0;

    border: 0;

    background: transparent;

    cursor: pointer;
  }

  .dropdown-arrow {
    display: inline-block;

    margin-top: -2px;

    color: var(--color-text-muted);

    font-size: 0.9rem;

    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-dropdown.is-open
    .dropdown-arrow {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .nav-dropdown-menu {
    position: absolute;

    top: calc(100% + 18px);
    left: 50%;

    width: 330px;

    transform:
      translateX(-50%)
      translateY(-6px);

    padding: 8px;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    background: rgba(255, 255, 255, 0.98);

    box-shadow:
      0 18px 45px rgba(6, 20, 38, 0.12);

    opacity: 0;
    visibility: hidden;

    pointer-events: none;

    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
  }

  .nav-dropdown.is-open
    .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;

    pointer-events: auto;

    transform:
      translateX(-50%)
      translateY(0);
  }

  .nav-dropdown-menu a {
    display: block;

    padding: 13px 14px;

    border-radius: var(--radius-sm);

    transition:
      background var(--transition-fast);
  }

  .nav-dropdown-menu a:hover {
    background: var(--color-surface-raised);
  }

  .dropdown-title {
    display: block;

    margin-bottom: 3px;

    color: var(--color-text);

    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;

    transition:
      color var(--transition-fast);
  }

  .nav-dropdown-menu a:hover
    .dropdown-title {
    color: var(--color-primary);
  }

  .dropdown-description {
    display: block;

    color: var(--color-text-muted);

    font-size: 0.7rem;
    line-height: 1.45;
  }

  /* =================================
     HEADER CTA
     ================================= */

  .header-cta {
    min-height: 42px;

    padding-inline: 18px;

    font-size: 0.78rem;

    flex-shrink: 0;
  }

  /* =================================
     MOBILE TOGGLE
  ================================= */

  .menu-toggle {
    display: none;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    background: var(--color-surface);

    align-items: center;
    justify-content: center;

    flex-direction: column;

    gap: 5px;

    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .menu-toggle:hover {
    border-color: var(--color-primary);

    background: var(--color-surface-raised);
  }

  .menu-toggle span {
    display: block;

    width: 18px;
    height: 2px;

    border-radius: 999px;

    background: var(--color-text);

    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  /* Hamburger → X */

  .menu-toggle.is-open
    span:nth-child(1) {
    transform:
      translateY(7px)
      rotate(45deg);
  }

  .menu-toggle.is-open
    span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.is-open
    span:nth-child(3) {
    transform:
      translateY(-7px)
      rotate(-45deg);
  }

  /* =================================
     MOBILE MENU
  ================================= */

  .mobile-menu {
    display: none;
  }

  /* =================================
     MOBILE SERVICES
  ================================= */

  .mobile-services {
    border-bottom: 1px solid
      var(--color-border);
  }

  .mobile-services-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;

    padding: 15px 0;

    border: 0;

    background: transparent;

    color: var(--color-text-secondary);

    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;

    text-align: left;

    cursor: pointer;
  }

  .mobile-services-trigger:hover {
    color: var(--color-primary);
  }

  .mobile-services-arrow {
    font-size: 1rem;

    transition:
      transform var(--transition-fast);
  }

  .mobile-services.is-open
    .mobile-services-arrow {
    transform: rotate(180deg);
  }

  .mobile-services-menu {
    display: none;

    padding: 0 0 8px 14px;
  }

  .mobile-services.is-open
    .mobile-services-menu {
    display: block;
  }

  .mobile-services-menu a {
    display: block;

    padding: 11px 0;

    border: 0 !important;

    color: var(--color-text-muted) !important;

    font-size: 0.84rem !important;
    font-weight: 500 !important;
  }

  .mobile-services-menu a:hover {
    color: var(--color-primary) !important;
  }

  /* =================================
     TABLET
  ================================= */

  @media (max-width: 1100px) {
    .desktop-nav {
      gap: 20px;
    }

    .desktop-nav > a,
    .nav-dropdown-trigger {
      font-size: 0.78rem;
    }

    .header-cta {
      padding-inline: 15px;
    }

    .header-inner {
      gap: 24px;
    }
  }

  /* =================================
     MOBILE / TABLET
  ================================= */

  @media (max-width: 960px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-menu.is-open {
      display: block;

      border-top: 1px solid
        var(--color-border);

      background: rgba(255, 255, 255, 0.98);

      padding:
        20px
        var(--container-padding)
        28px;

      box-shadow:
        0 14px 32px
        rgba(6, 20, 38, 0.08);
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
    }

    .mobile-menu nav > a {
      display: block;

      padding: 15px 0;

      border-bottom: 1px solid
        var(--color-border);

      color: var(--color-text-secondary);

      font-size: 0.95rem;
      font-weight: 600;

      transition:
        color var(--transition-fast);
    }

    .mobile-menu nav > a:hover {
      color: var(--color-primary);
    }

    .mobile-cta {
      width: 100%;

      margin-top: 22px;

      min-height: 48px;

      font-size: 0.88rem;
    }
  }

  /* =================================
     SMALL MOBILE
  ================================= */

  @media (max-width: 600px) {
    .header-inner {
      min-height: 70px;
    }

    .brand-logo {
      width: 150px;
    }
  }
</style>