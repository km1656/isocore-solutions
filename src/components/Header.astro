<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Isocore Solutions home">
      <img
        src="/images/isocore.svg"
        alt="Isocore Solutions"
        class="brand-logo"
      />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/platforms">Platforms</a>
      <a href="/insights">Insights</a>
      <a href="/contact">Contact</a>
    </nav>

    <a href="/contact" class="header-cta">
      Schedule IAM Assessment
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav aria-label="Mobile navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/platforms">Platforms</a>
      <a href="/insights">Insights</a>
      <a href="/contact">Contact</a>
    </nav>

    <a href="/contact" class="mobile-cta">
      Schedule IAM Assessment
      <span>→</span>
    </a>
  </div>
</header>

<script>
  const menuToggle = document.querySelector(".menu-toggle");
  const mobileMenu = document.querySelector(".mobile-menu");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";

    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    mobileMenu?.classList.toggle("is-open", !isOpen);
    menuToggle.classList.toggle("is-open", !isOpen);
  });
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;

    border-bottom: 1px solid rgba(25, 58, 89, 0.55);

    background: rgba(6, 20, 38, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    min-height: 76px;
    gap: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    margin-right: auto;
  }

  .brand-logo {
    display: block;
    width: 150px;
    height: auto;
  }

  /* Desktop navigation */

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .desktop-nav a {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    font-weight: 500;

    transition: color 160ms ease;
  }

  .desktop-nav a:hover {
    color: var(--color-text);
  }

  /* Desktop CTA */

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding: 0 18px;

    border-radius: var(--radius-sm);

    background: var(--color-primary);
    color: var(--color-white);

    font-size: 0.82rem;
    font-weight: 700;
  }

  .header-cta:hover {
    background: var(--color-primary-hover);
  }

  /* Mobile button */

  .menu-toggle {
    display: none;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    background: var(--color-surface);

    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .menu-toggle span {
    width: 18px;
    height: 1px;
    background: var(--color-text);

    transition: transform 160ms ease, opacity 160ms ease;
  }

  /* Mobile menu */

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1050px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-menu.is-open {
      display: block;

      border-top: 1px solid var(--color-border);

      background: rgba(6, 20, 38, 0.98);

      padding: 24px var(--container-padding) 32px;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
    }

    .mobile-menu nav a {
      padding: 16px 0;

      border-bottom: 1px solid rgba(25, 58, 89, 0.5);

      color: var(--color-text-secondary);
    }

    .mobile-menu nav a:hover {
      color: var(--color-cyan);
    }

    .mobile-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-top: 24px;
      padding: 15px 18px;

      border-radius: var(--radius-sm);

      background: var(--color-primary);
      color: var(--color-white);

      font-weight: 700;
    }
  }

  @media (max-width: 600px) {
    .header-inner {
      min-height: 68px;
    }

    .brand-logo {
      width: 135px;
    }
  }
</style>