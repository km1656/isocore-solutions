---
const trustItems = [
  {
    label: "Identity Focus",
    title: "Architecture & Modernization",
  },
  {
    label: "End-to-End IAM",
    title: "Strategy · Implementation · Governance · Support",
  },
  {
    label: "Vendor Agnostic",
    title: "Enterprise Platform Expertise",
  },
];
---

<section class="trust-strip" aria-label="Isocore capabilities">
  <div class="trust-inner">
    {trustItems.map((item, index) => (
      <div class="trust-item">
        <div class="trust-content">
          <span class="trust-label">{item.label}</span>
          <span class="trust-title">{item.title}</span>
        </div>

        {index < trustItems.length - 1 && (
          <span class="trust-divider" aria-hidden="true"></span>
        )}
      </div>
    ))}
  </div>
</section>

<style>
 .trust-strip {
  position: relative;
  width: 100%;

  border-top: 1px solid rgba(0, 114, 255, 0.18);
  border-bottom: 1px solid rgba(0, 114, 255, 0.18);

  background:
  linear-gradient(
    105deg,
    rgba(0, 180, 219, 0.14) 0%,
    rgba(0, 114, 255, 0.10) 55%,
    rgba(0, 184, 184, 0.08) 100%
  );
}

  .trust-inner {
    width: min(1320px, calc(100% - 48px));
    min-height: 112px;
    margin-inline: auto;

    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    align-items: center;
  }

  .trust-item {
    position: relative;
    min-width: 0;
    padding: 22px 34px;
  }

  .trust-item:first-child {
    padding-left: 0;
  }

  .trust-item:last-child {
    padding-right: 0;
  }

  .trust-content {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .trust-label {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .trust-title {
    color: var(--color-text);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .trust-divider {
    position: absolute;
    top: 50%;
    right: 0;

    width: 1px;
    height: 42px;

    transform: translateY(-50%);
    background: var(--color-border);
  }

  .trust-item {
    transition: transform var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .trust-item:hover {
      transform: translateY(-1px);
    }
  }

  @media (max-width: 900px) {
    .trust-inner {
      grid-template-columns: 1fr;
      padding-block: 10px;
    }

    .trust-item,
    .trust-item:first-child,
    .trust-item:last-child {
      padding: 18px 0;
    }

    .trust-divider {
      top: auto;
      right: 0;
      bottom: 0;

      width: 100%;
      height: 1px;

      transform: none;
    }

    .trust-item:last-child .trust-divider {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .trust-inner {
      width: calc(100% - 40px);
    }

    .trust-item {
      padding-block: 17px;
    }

    .trust-label {
      font-size: 0.58rem;
    }

    .trust-title {
      font-size: 0.8rem;
    }
  }
</style>