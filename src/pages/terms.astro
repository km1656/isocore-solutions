<style>
  .legal-hero {
    padding: 150px 0 90px;
    background:
      radial-gradient(
        circle at 75% 25%,
        rgba(0, 180, 219, 0.08),
        transparent 32%
      ),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-hero h1 {
    max-width: 900px;
    margin-bottom: 24px;
  }

  .legal-intro {
    max-width: 720px;
    margin-bottom: 32px;
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .legal-meta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .legal-meta strong {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .legal-content {
    padding: 90px 0 120px;
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 780px);
    gap: 80px;
    align-items: start;
  }

  .legal-nav {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .legal-nav span {
    margin-bottom: 10px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .legal-nav a {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.4;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .legal-nav a:hover {
    color: var(--color-primary);
    transform: translateX(2px);
  }

  .legal-body {
    min-width: 0;
  }

  .legal-body > p:first-child {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .legal-body h2 {
    margin-top: 58px;
    margin-bottom: 18px;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
    scroll-margin-top: 110px;
  }

  .legal-body p {
    margin-bottom: 18px;
    line-height: 1.75;
  }

  .legal-body ul {
    margin: 0 0 24px;
    padding-left: 22px;
    color: var(--color-text-secondary);
  }

  .legal-body li {
    margin-bottom: 10px;
    padding-left: 6px;
    line-height: 1.7;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 24px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
  }

  .contact-card strong {
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .contact-card a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .contact-card span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .legal-nav {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 20px;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--color-border);
    }

    .legal-nav span {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .legal-hero {
      padding: 110px 0 70px;
    }

    .legal-content {
      padding: 70px 0 90px;
    }

    .legal-nav {
      grid-template-columns: 1fr;
    }
  }
</style>