---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
---

<BaseLayout
  title="Privacy Policy | Isocore Solutions"
  description="Privacy Policy for Isocore Solutions LLC."
>
  <main>
    <section class="legal-hero">
      <div class="container">
        <Eyebrow text="Privacy & Data" variant="bracket" />

        <h1>Privacy Policy</h1>

        <p class="legal-intro">
          How Isocore Solutions LLC collects, uses, and protects information
          when you visit our website or contact us.
        </p>

        <div class="legal-meta">
          <span>Effective Date</span>
          <strong>August 17, 2026</strong>
        </div>
      </div>
    </section>

    <section class="legal-content">
      <div class="container legal-layout">
        <aside class="legal-nav" aria-label="Privacy Policy sections">
          <span>On this page</span>
          <a href="#information-we-collect">Information We Collect</a>
          <a href="#how-we-use-information">How We Use Information</a>
          <a href="#analytics">Analytics</a>
          <a href="#forms">Forms & Communications</a>
          <a href="#cloudflare">Cloudflare Services</a>
          <a href="#cookies">Cookies & Similar Technologies</a>
          <a href="#sharing">Information Sharing</a>
          <a href="#retention">Data Retention</a>
          <a href="#security">Security</a>
          <a href="#your-rights">Your Choices & Rights</a>
          <a href="#children">Children's Privacy</a>
          <a href="#changes">Changes to This Policy</a>
          <a href="#contact">Contact</a>
        </aside>

        <article class="legal-body">
          <p>
            Isocore Solutions LLC ("Isocore," "we," "us," or "our") respects
            your privacy. This Privacy Policy explains how information may be
            collected, used, and disclosed when you use the Isocore Solutions
            website and related online services.
          </p>

          <p>
            This policy applies to information collected through our website,
            including when you browse our pages, submit an inquiry, or
            otherwise interact with functionality made available through the
            site.
          </p>

          <h2 id="information-we-collect">Information We Collect</h2>

          <p>
            Depending on how you interact with the website, we may collect
            information such as:
          </p>

          <ul>
            <li>
              Information you voluntarily provide through forms, such as your
              name, email address, company, role, and message.
            </li>
            <li>
              Information contained in communications you send to us.
            </li>
            <li>
              Technical information associated with your visit, such as
              browser, device, approximate geographic information, pages
              visited, referring information, and other standard web
              interaction data.
            </li>
            <li>
              Information collected through analytics and security services
              used on the website.
            </li>
          </ul>

          <h2 id="how-we-use-information">How We Use Information</h2>

          <p>
            We may use information collected through the website to:
          </p>

          <ul>
            <li>Respond to inquiries and requests for information.</li>
            <li>
              Evaluate and respond to requests for IAM assessments or other
              services.
            </li>
            <li>
              Operate, maintain, secure, and improve the website.
            </li>
            <li>
              Understand website usage and improve content and user
              experience.
            </li>
            <li>
              Detect, prevent, and investigate abuse, fraud, security
              incidents, or other misuse.
            </li>
            <li>
              Comply with applicable legal, regulatory, or contractual
              requirements.
            </li>
          </ul>

          <h2 id="analytics">Analytics</h2>

          <p>
            We use Google Analytics 4 ("GA4") to understand how visitors
            interact with the website. GA4 may collect information such as
            pages viewed, interactions, approximate location, device and
            browser information, and other usage information.
          </p>

          <p>
            Analytics information is used to understand website performance,
            improve our content and services, and evaluate how visitors
            interact with the site.
          </p>

          <p>
            Google may process information collected through Google Analytics
            in accordance with its own privacy practices and policies. Your
            browser may also provide controls for limiting certain forms of
            tracking or measurement.
          </p>

          <h2 id="forms">Forms & Communications</h2>

          <p>
            If you submit information through a form on our website, we use
            that information to respond to your request and provide the
            services or information you requested.
          </p>

          <p>
            We may use third-party service providers to transmit or process
            form submissions. Our website may use Resend to facilitate the
            delivery of email communications resulting from form
            submissions.
          </p>

          <p>
            Information submitted through a form should be limited to
            information necessary for your inquiry. Please do not submit
            passwords, authentication secrets, credentials, or other
            sensitive security information through website forms.
          </p>

          <h2 id="cloudflare">Cloudflare Services</h2>

          <p>
            We may use Cloudflare services, including Cloudflare Turnstile,
            to help protect website forms and other functionality from spam,
            automated abuse, and malicious activity.
          </p>

          <p>
            Cloudflare may process technical information associated with a
            request in order to provide security and abuse-prevention
            services. Depending on the services enabled, Cloudflare may also
            use cookies or similar technologies and may provide its own
            analytics or security telemetry.
          </p>

          <p>
            Cloudflare processes information according to its applicable
            privacy practices and terms.
          </p>

          <h2 id="cookies">Cookies & Similar Technologies</h2>

          <p>
            The website may use cookies, local storage, scripts, pixels, or
            similar technologies where necessary to provide functionality,
            maintain security, understand website usage, or support
            third-party services.
          </p>

          <p>
            In particular, services such as Google Analytics and Cloudflare
            may use cookies or similar technologies as part of their
            respective functionality.
          </p>

          <p>
            You can generally control cookies through your browser settings.
            Disabling certain cookies or technologies may affect the
            functionality of portions of the website.
          </p>

          <h2 id="sharing">Information Sharing</h2>

          <p>
            We may share information with service providers that perform
            services on our behalf, such as website infrastructure, analytics,
            security, communications, email delivery, and related technical
            services.
          </p>

          <p>
            We may also disclose information when reasonably necessary to
            comply with applicable law, legal process, governmental requests,
            protect the rights or property of Isocore or others, investigate
            security or abuse incidents, or protect the safety of users.
          </p>

          <p>
            We do not use information submitted through this website for
            purposes unrelated to the purposes described in this policy
            without an applicable legal basis or appropriate notice.
          </p>

          <h2 id="retention">Data Retention</h2>

          <p>
            We retain information for as long as reasonably necessary for the
            purposes for which it was collected, including responding to
            inquiries, maintaining business records, providing services,
            resolving disputes, enforcing agreements, and complying with
            legal obligations.
          </p>

          <p>
            Retention periods may vary depending on the type and nature of
            information and the reason it was collected.
          </p>

          <h2 id="security">Security</h2>

          <p>
            We use reasonable administrative, technical, and organizational
            measures designed to protect information against unauthorized
            access, disclosure, alteration, or destruction.
          </p>

          <p>
            No internet transmission or electronic storage system can be
            guaranteed to be completely secure. Accordingly, we cannot
            guarantee absolute security.
          </p>

          <h2 id="your-rights">Your Choices & Rights</h2>

          <p>
            Depending on where you reside and applicable law, you may have
            rights regarding personal information, which can include rights
            to request access to, correction of, deletion of, or information
            about the processing of your personal information.
          </p>

          <p>
            To make a privacy-related request, contact us using the address
            below. We may need to verify your identity before fulfilling a
            request.
          </p>

          <h2 id="children">Children's Privacy</h2>

          <p>
            Our website and services are intended for business and
            professional audiences. We do not knowingly solicit personal
            information from children.
          </p>

          <h2 id="changes">Changes to This Policy</h2>

          <p>
            We may update this Privacy Policy from time to time to reflect
            changes to our website, services, technology, legal requirements,
            or privacy practices.
          </p>

          <p>
            When we make changes, we will update the effective date shown at
            the beginning of this policy. Your continued use of the website
            after an updated policy becomes effective constitutes use subject
            to the updated policy, to the extent permitted by law.
          </p>

          <h2 id="contact">Contact</h2>

          <p>
            If you have questions about this Privacy Policy or want to make a
            privacy-related request, contact:
          </p>

          <div class="contact-card">
            <strong>Isocore Solutions LLC</strong>
            <a href="mailto:hr@isocoresolutions.com">
              hr@isocoresolutions.com
            </a>
            <span>Wyoming, United States</span>
          </div>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .legal-hero {
    padding: 150px 0 90px;
    background:
      radial-gradient(
        circle at 75% 25%,
        rgba(0, 180, 219, 0.08),
        transparent 32%
      ),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-hero h1 {
    max-width: 900px;
    margin-bottom: 24px;
  }

  .legal-intro {
    max-width: 720px;
    margin-bottom: 32px;
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .legal-meta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .legal-meta strong {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .legal-content {
    padding: 90px 0 120px;
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 780px);
    gap: 80px;
    align-items: start;
  }

  .legal-nav {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .legal-nav span {
    margin-bottom: 10px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .legal-nav a {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.4;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .legal-nav a:hover {
    color: var(--color-primary);
    transform: translateX(2px);
  }

  .legal-body {
    min-width: 0;
  }

  .legal-body > p:first-child {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .legal-body h2 {
    margin-top: 58px;
    margin-bottom: 18px;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
    scroll-margin-top: 110px;
  }

  .legal-body p {
    margin-bottom: 18px;
    line-height: 1.75;
  }

  .legal-body ul {
    margin: 0 0 24px;
    padding-left: 22px;
    color: var(--color-text-secondary);
  }

  .legal-body li {
    margin-bottom: 10px;
    padding-left: 6px;
    line-height: 1.7;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 24px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
  }

  .contact-card strong {
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .contact-card a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .contact-card span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .legal-nav {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 20px;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--color-border);
    }

    .legal-nav span {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .legal-hero {
      padding: 110px 0 70px;
    }

    .legal-content {
      padding: 70px 0 90px;
    }

    .legal-nav {
      grid-template-columns: 1fr;
    }
  }
</style>