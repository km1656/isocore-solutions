---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CTASection from "../../components/CTASection.astro";
---

<BaseLayout
  title="About | Isocore Solutions"
  description="Isocore Solutions provides enterprise Identity & Access Management engineering, modernization, implementation, and support."
>
  <main>
    <!-- HERO -->
    <section class="about-hero">
      <div class="about-grid" aria-hidden="true"></div>
      <div class="about-glow" aria-hidden="true"></div>

      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <Eyebrow variant="bracket" text="About Isocore" />

          <h1>
            Engineering identity
            <span class="text-gradient"> for the enterprise.</span>
          </h1>

          <p>
            Isocore Solutions helps organizations design, modernize,
            implement, and operate the identity infrastructure that
            connects people, applications, devices, and systems.
          </p>
        </div>

        <div class="about-hero-statement">
          <span class="statement-line"></span>

          <p>
            Identity is infrastructure.
            <br />
            We treat it that way.
          </p>
        </div>
      </div>
    </section>


    <!-- COMPANY -->
    <section class="about-company section">
      <div class="about-company-inner">
        <div class="section-header">
          <Eyebrow variant="bracket" text="Who We Are" />

          <h2>
            Built around
            <span class="text-gradient"> identity.</span>
          </h2>
        </div>

        <div class="company-content">
          <div class="company-lead">
            <p>
              Isocore Solutions is an enterprise technology company
              focused on Identity & Access Management.
            </p>

            <p>
              We work across the identity lifecycle—from architecture
              and strategy through implementation, modernization,
              integration, governance, and ongoing support.
            </p>
          </div>

          <div class="company-detail">
            <p>
              Enterprise identity environments are rarely simple.
              They span legacy infrastructure, cloud platforms,
              directories, applications, authentication systems,
              security controls, and operational processes.
            </p>

            <p>
              Our approach is to understand that environment as a
              connected system and engineer identity solutions around
              the organization's actual requirements.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- APPROACH -->
    <section class="about-approach">
      <div class="approach-inner">
        <div class="approach-intro">
          <Eyebrow variant="bracket" text="Our Approach" />

          <h2>
            Practical engineering.
            <span class="text-gradient"> Long-term thinking.</span>
          </h2>

          <p>
            Identity platforms have to work in the real world—not
            simply look good in an architecture diagram.
          </p>
        </div>

        <div class="approach-points">
          <article class="approach-point">
            <h3>Understand the environment</h3>

            <p>
              We start with the existing identity landscape,
              business requirements, dependencies, security
              controls, and operational realities.
            </p>
          </article>

          <article class="approach-point">
            <h3>Design for the enterprise</h3>

            <p>
              Architecture decisions are made with scalability,
              resilience, integration, governance, and maintainability
              in mind.
            </p>
          </article>

          <article class="approach-point">
            <h3>Modernize deliberately</h3>

            <p>
              Legacy identity infrastructure cannot always be
              replaced overnight. We create structured paths from
              existing environments toward modern identity platforms.
            </p>
          </article>

          <article class="approach-point">
            <h3>Engineer for continuity</h3>

            <p>
              The objective is not simply to deploy a platform.
              Identity environments need to remain supportable,
              governed, secure, and adaptable as the enterprise evolves.
            </p>
          </article>
        </div>
      </div>
    </section>


    <!-- CAPABILITIES -->
    <section class="about-capabilities section">
      <div class="capabilities-inner">
        <div class="section-header">
          <Eyebrow variant="bracket" text="What We Do" />

          <h2>
            Identity expertise across
            <span class="text-gradient"> the lifecycle.</span>
          </h2>

          <p>
            Our services span the strategic, technical, and operational
            layers of enterprise identity.
          </p>
        </div>

        <div class="capability-grid">
          <article class="capability">
            <h3>IAM Strategy & Architecture</h3>
            <p>
              Identity architecture, roadmap development,
              platform strategy, and enterprise IAM planning.
            </p>
            <a href="/services/iam-strategy-architecture">
              Explore service <span aria-hidden="true">→</span>
            </a>
          </article>

          <article class="capability">
            <h3>Identity Modernization</h3>
            <p>
              Directory transformation, legacy modernization,
              migration planning, and hybrid identity evolution.
            </p>
            <a href="/services/identity-modernization">
              Explore service <span aria-hidden="true">→</span>
            </a>
          </article>

          <article class="capability">
            <h3>Implementation & Integration</h3>
            <p>
              Identity platform implementation, application
              integration, authentication, federation, and provisioning.
            </p>
            <a href="/services/implementation-integration">
              Explore service <span aria-hidden="true">→</span>
            </a>
          </article>

          <article class="capability">
            <h3>Managed Identity & Support</h3>
            <p>
              Ongoing identity operations, platform support,
              optimization, governance, and technical expertise.
            </p>
            <a href="/services/managed-identity-support">
              Explore service <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>


    <!-- ECOSYSTEM -->
    <section class="about-ecosystem">
      <div class="ecosystem-inner">
        <div class="ecosystem-copy">
          <Eyebrow variant="bracket" text="Enterprise Perspective" />

          <h2>
            Identity does not exist
            <span class="text-gradient"> in isolation.</span>
          </h2>

          <p>
            Enterprise identity connects multiple technical and
            organizational layers. Our work considers the complete
            environment rather than treating IAM as a standalone system.
          </p>
        </div>

        <div class="ecosystem-map">
          <div class="ecosystem-row">
            <span>Identity & Access</span>
            <span>IAM Platforms</span>
            <span>Access Management</span>
            <span>Identity Governance</span>
          </div>

          <div class="ecosystem-row">
            <span>Directory & Infrastructure</span>
            <span>Active Directory</span>
            <span>LDAP</span>
            <span>Directory Services</span>
          </div>

          <div class="ecosystem-row">
            <span>Authentication</span>
            <span>SSO</span>
            <span>MFA</span>
            <span>Federation</span>
          </div>

          <div class="ecosystem-row">
            <span>Cloud & Hybrid</span>
            <span>Cloud Identity</span>
            <span>Hybrid Identity</span>
            <span>Enterprise Integration</span>
          </div>

          <div class="ecosystem-row">
            <span>Applications</span>
            <span>Application Onboarding</span>
            <span>Identity APIs</span>
            <span>Provisioning</span>
          </div>
        </div>
      </div>
    </section>


    <CTASection />
  </main>
</BaseLayout>


<style>
  /* =================================
     HERO
     ================================= */

  .about-hero {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: center;
    overflow: hidden;

    background:
      radial-gradient(
        circle at 78% 42%,
        rgba(0, 180, 219, 0.07),
        transparent 30%
      ),
      radial-gradient(
        circle at 20% 85%,
        rgba(0, 114, 255, 0.045),
        transparent 30%
      ),
      var(--color-bg);
  }

  .about-grid {
    position: absolute;
    inset: 0;

    opacity: 0.32;

    background-image:
      linear-gradient(
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      );

    background-size: 72px 72px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 90%
      );
  }

  .about-glow {
    position: absolute;

    width: 480px;
    height: 480px;

    right: -180px;
    top: 15%;

    border-radius: 50%;

    background: var(--color-cyan);

    opacity: 0.045;
    filter: blur(110px);
  }

  .about-hero-inner {
    position: relative;
    z-index: 2;

    width: min(
      1320px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(280px, 0.55fr);

    gap: 100px;

    align-items: end;

    padding-block: 130px 100px;
  }

  .about-hero-copy {
    max-width: 760px;
  }

  .about-hero h1 {
    margin: 0 0 30px;

    font-size: clamp(
      3.4rem,
      6vw,
      5.25rem
    );

    line-height: 0.99;
    letter-spacing: -0.055em;
  }

  .about-hero-copy > p {
    max-width: 650px;
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 1rem;
    line-height: 1.8;
  }

  .about-hero-statement {
    padding-left: 28px;
    padding-bottom: 8px;

    border-left: 1px solid var(--color-border-strong);
  }

  .statement-line {
    display: block;

    width: 34px;
    height: 2px;

    margin-bottom: 18px;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        var(--color-cyan)
      );
  }

  .about-hero-statement p {
    margin: 0;

    color: var(--color-text);

    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }


  /* =================================
     COMPANY
     ================================= */

  .about-company {
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-company-inner {
    width: min(
      1320px,
      calc(100% - 48px)
    );

    margin-inline: auto;
  }

  .section-header {
    max-width: 760px;
  }

  .section-header h2 {
    margin-bottom: 20px;

    font-size: clamp(
      2.5rem,
      4.5vw,
      3.8rem
    );
  }

  .section-header > p {
    max-width: 650px;
    margin: 0;

    font-size: 0.98rem;
    line-height: 1.75;
  }

  .company-content {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    gap: 100px;

    margin-top: 58px;
    padding-top: 42px;

    border-top: 1px solid var(--color-border);
  }

  .company-content p {
    margin: 0 0 20px;

    font-size: 0.94rem;
    line-height: 1.8;
  }

  .company-content p:last-child {
    margin-bottom: 0;
  }

  .company-lead p:first-child {
    color: var(--color-text);

    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }


  /* =================================
     APPROACH
     ================================= */

  .about-approach {
    padding-block: 120px;

    background: var(--color-bg);
  }

  .approach-inner {
    width: min(
      1320px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: grid;
    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap: 110px;
  }

  .approach-intro {
    max-width: 520px;
  }

  .approach-intro h2 {
    margin: 0 0 24px;

    font-size: clamp(
      2.4rem,
      4.2vw,
      3.6rem
    );
  }

  .approach-intro p {
    margin: 0;

    font-size: 0.96rem;
    line-height: 1.8;
  }

  .approach-points {
    border-top: 1px solid var(--color-border);
  }

  .approach-point {
    padding-block: 29px 31px;

    border-bottom: 1px solid var(--color-border);
  }

  .approach-point h3 {
    margin: 0 0 10px;

    font-size: 1.15rem;
  }

  .approach-point p {
    max-width: 620px;
    margin: 0;

    font-size: 0.88rem;
    line-height: 1.75;
  }


  /* =================================
     CAPABILITIES
     ================================= */

  .about-capabilities {
    background: var(--color-white);
  }

  .capabilities-inner {
    width: min(
      1320px,
      calc(100% - 48px)
    );

    margin-inline: auto;
  }

  .capability-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    margin-top: 58px;

    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .capability {
    position: relative;

    min-height: 245px;

    padding: 34px;

    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);

    transition:
      background var(--transition-normal),
      transform var(--transition-normal);
  }

  .capability:hover {
    background:
    linear-gradient(
      145deg,
      #008fd0 10%,
      #00b8c8 55%,
      #0a2a6b 100%
    );
    transform: translateY(-3px);
    transform: perspective(10px);
  }

.capability:hover h3, .capability:hover a {
  color: var(--color-white);
}
  .capability:hover p {
  color: rgba(255, 255, 255, 0.78);
}

  .capability h3 {
    margin: 0 0 13px;

    font-size: 1.2rem;
  }

  .capability p {
    max-width: 480px;
    margin: 0;

    font-size: 0.87rem;
    line-height: 1.75;
  }

  .capability a {
    position: absolute;
    bottom: 32px;
    left: 34px;

    display: inline-flex;
    align-items: center;
    gap: 8px;

    color: var(--color-primary);

    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .capability a span {
    font-size: 0.9rem;

    transition:
      transform var(--transition-fast);
  }

  .capability:hover a span {
    transform: translateX(3px);
  }


  /* =================================
     ECOSYSTEM
     ================================= */

  .about-ecosystem {
    padding-block: 120px;

    background: var(--color-dark);
    color: var(--color-white);
  }

  .ecosystem-inner {
    width: min(
      1320px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: grid;
    grid-template-columns:
      minmax(0, 0.75fr)
      minmax(0, 1.25fr);

    gap: 100px;

    align-items: center;
  }

  .ecosystem-copy {
    max-width: 520px;
  }

  .ecosystem-copy h2 {
    margin: 0 0 24px;

    color: var(--color-white);

    font-size: clamp(
      2.4rem,
      4vw,
      3.5rem
    );
  }

  .ecosystem-copy p {
    margin: 0;

    color: #a9bbcd;

    font-size: 0.94rem;
    line-height: 1.8;
  }

  .ecosystem-map {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .ecosystem-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr 1fr;

    align-items: center;

    min-height: 74px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .ecosystem-row span {
    padding-right: 18px;

    color: #a9bbcd;

    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .ecosystem-row span:first-child {
    color: var(--color-white);

    font-size: 0.63rem;
    font-weight: 600;
  }


  /* =================================
     RESPONSIVE
     ================================= */

  @media (max-width: 1000px) {
    .about-hero-inner {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .about-hero-statement {
      max-width: 500px;
    }

    .company-content,
    .approach-inner,
    .ecosystem-inner {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .company-content {
      gap: 35px;
    }

    .approach-inner,
    .ecosystem-inner {
      gap: 55px;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      min-height: auto;
    }

    .about-hero-inner {
      width: calc(100% - 40px);
      padding-block: 105px 80px;
    }

    .about-hero h1 {
      font-size: clamp(
        2.9rem,
        11vw,
        4rem
      );
    }

    .section {
      padding-block: 88px;
    }

    .about-approach,
    .about-ecosystem {
      padding-block: 88px;
    }

    .about-company-inner,
    .capabilities-inner,
    .approach-inner,
    .ecosystem-inner {
      width: calc(100% - 40px);
    }

    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability {
      min-height: 225px;
      padding: 29px;
    }

    .capability a {
      left: 29px;
      bottom: 27px;
    }

    .ecosystem-row {
      grid-template-columns: 1fr 1fr;
      gap: 14px;

      padding-block: 18px;
    }

    .ecosystem-row span {
      padding-right: 0;
    }
  }

  @media (max-width: 500px) {
    .about-hero-inner,
    .about-company-inner,
    .capabilities-inner,
    .approach-inner,
    .ecosystem-inner {
      width: calc(100% - 32px);
    }

    .about-hero-inner {
      padding-block: 92px 65px;
    }

    .about-hero-statement {
      padding-left: 20px;
    }

    .company-content {
      margin-top: 42px;
      padding-top: 32px;
    }

    .capability {
      min-height: 235px;
    }

    .ecosystem-row {
      grid-template-columns: 1fr;
      gap: 7px;
    }
  }
</style>