---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main>
    <section class="hero">
      <div class="hero-glow"></div>

      <div class="container hero-content">
        <div class="section-eyebrow">
          Enterprise Identity Engineering
        </div>

        <h1>
          Secure access.
          <span class="text-gradient">Modern identity.</span>
        </h1>

        <p class="hero-copy">
          Isocore Solutions helps enterprise organizations
          modernize Identity & Access Management across cloud,
          hybrid, and on-premises environments.
        </p>

        <div class="actions">
          <a href="/contact" class="button button-primary">
            Schedule an IAM Assessment
          </a>

          <a href="/services" class="button button-secondary">
            Explore Our Services
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cards">
          <article class="card">
            <span class="card-number">01</span>
            <h2>Control & Governance</h2>
            <p>
              Build controlled identity lifecycles, access
              policies, and governance across the enterprise.
            </p>
          </article>

          <article class="card">
            <span class="card-number">02</span>
            <h2>Modern Access</h2>
            <p>
              Enable secure SSO, MFA, conditional access,
              federation, and passwordless authentication.
            </p>
          </article>

          <article class="card">
            <span class="card-number">03</span>
            <h2>Hybrid Identity</h2>
            <p>
              Connect legacy directory infrastructure with
              modern cloud identity without disrupting operations.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 760px;

    display: grid;
    align-items: center;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 75% 40%,
        rgba(0, 180, 219, 0.08),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        var(--color-bg),
        var(--color-surface)
      );
  }

  .hero::after {
    content: "";

    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(
        rgba(25, 58, 89, 0.18) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(25, 58, 89, 0.18) 1px,
        transparent 1px
      );

    background-size: 64px 64px;

    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 80%
    );

    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;

    padding-block: 120px;
  }

  .hero h1 {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .hero-copy {
    max-width: 680px;

    margin-bottom: 40px;

    font-size: 1.15rem;
    line-height: 1.8;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 52px;
    padding: 0 24px;

    border-radius: var(--radius-sm);

    font-weight: 700;

    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    border: 1px solid var(--color-border);
    background: rgba(10, 29, 51, 0.5);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    padding: 32px;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: var(--shadow-card);

    transition:
      border-color var(--transition-normal),
      transform var(--transition-normal);
  }

  .card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .card-number {
    display: block;

    margin-bottom: 24px;

    color: var(--color-cyan);

    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .card h2 {
    margin-bottom: 16px;
    font-size: 1.35rem;
  }

  .card p {
    margin-bottom: 0;
  }

  @media (max-width: 800px) {
    .hero {
      min-height: 680px;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>