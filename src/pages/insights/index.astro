---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";

const insights = [
  {
    type: "Perspective",
    title: "Why Identity Should Be Treated as Infrastructure",
    description:
      "A stronger identity program starts with an architectural mindset: identity is a foundational enterprise capability, not simply another security tool.",
    href: "#",
  },
  {
    type: "Technical Guide",
    title: "Designing Identity for the Hybrid Enterprise",
    description:
      "The architectural considerations that matter when identity spans cloud platforms, legacy directories, applications, and distributed environments.",
    href: "#",
  },
  {
    type: "Perspective",
    title: "Architecture First. Technology Second.",
    description:
      "Why successful IAM programs begin with business requirements, identity flows, and target architecture before selecting or changing platforms.",
    href: "#",
  },
  {
    type: "Technical Guide",
    title: "Building a Modern Identity Lifecycle",
    description:
      "A practical look at joiner, mover, and leaver processes and the identity controls required to make lifecycle management reliable.",
    href: "#",
  },
  {
    type: "Perspective",
    title: "Modernizing Identity Without Disruption",
    description:
      "How enterprises can evolve legacy identity environments deliberately while maintaining continuity for users and applications.",
    href: "#",
  },
  {
    type: "Technical Guide",
    title: "Federation as an Enterprise Architecture Pattern",
    description:
      "Understanding authentication federation, trust relationships, application integration, and the role of standards in modern IAM.",
    href: "#",
  },
];
---

<BaseLayout
  title="Insights | Isocore Solutions"
  description="Perspectives, technical guidance, and enterprise identity engineering insights from Isocore Solutions."
>
  <main>

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="insights-hero">
      <div class="hero-grid" aria-hidden="true"></div>

      <div class="container insights-hero-inner">

        <div class="hero-copy">
          <Eyebrow
            text="Isocore Insights"
            variant="bracket"
          />

          <h1>
            Identity engineering
            <span class="text-gradient"> for the enterprise.</span>
          </h1>

          <p>
            Perspectives, technical guidance, and practical thinking
            for building identity as a foundational enterprise capability.
          </p>
        </div>

      </div>
    </section>


    <!-- =========================================
         CATEGORY NAV
    ========================================== -->

    <section class="category-section">
      <div class="container">

        <div class="category-nav">

          <a href="#latest" class="category-link is-active">
            <span>Perspectives</span>
            <small>Thought leadership</small>
          </a>

          <a href="#technical-guides" class="category-link">
            <span>Technical Guides</span>
            <small>Engineering guidance</small>
          </a>

          <a href="#case-studies" class="category-link">
            <span>Case Studies</span>
            <small>Selected engagements</small>
          </a>

        </div>

      </div>
    </section>


    <!-- =========================================
         FEATURED INSIGHT
    ========================================== -->

    <section class="featured-section">
      <div class="container">

        <div class="section-header">
          <Eyebrow
            text="Featured Insight"
            variant="system"
          />

          <h2>
            Identity is infrastructure.
            <span class="text-gradient">
              Build it accordingly.
            </span>
          </h2>
        </div>


        <article class="featured-card">

          <div class="featured-content">

            <div class="content-meta">
              <span>Perspective</span>
              <span>Enterprise IAM</span>
            </div>

            <h3>
              Why Identity Should Be Treated as Infrastructure
            </h3>

            <p>
              Identity sits beneath applications, security controls,
              workforce access, and increasingly the way organizations
              operate across cloud and hybrid environments.
            </p>

            <p>
              Treating IAM as infrastructure changes how organizations
              approach architecture, modernization, governance, and
              long-term operational resilience.
            </p>

            <a href="#" class="button button-primary">
              <span>Read the Perspective</span>
              <span aria-hidden="true">→</span>
            </a>

          </div>


          <div class="featured-visual" aria-hidden="true">

            <div class="architecture-frame">

              <div class="architecture-node node-user">
                <span>User</span>
              </div>

              <div class="architecture-line line-one"></div>

              <div class="architecture-node node-identity">
                <span>Identity</span>
              </div>

              <div class="architecture-line line-two"></div>

              <div class="architecture-node node-enterprise">
                <span>Enterprise</span>
              </div>

              <div class="architecture-line line-three"></div>

              <div class="architecture-node node-applications">
                <span>Applications</span>
              </div>

            </div>

          </div>

        </article>

      </div>
    </section>


    <!-- =========================================
         LATEST INSIGHTS
    ========================================== -->

    <section class="latest-section" id="latest">
      <div class="container">

        <div class="section-header section-header-row">

          <div>
            <Eyebrow
              text="Latest Insights"
              variant="line"
            />

            <h2>
              Thinking beyond
              <span class="text-gradient"> the platform.</span>
            </h2>
          </div>

          <p>
            Practical perspectives on identity strategy,
            architecture, modernization, and engineering.
          </p>

        </div>


        <div class="insights-grid">

          {insights.map((insight) => (
            <article class="insight-card">

              <div class="insight-card-top">

                <span class="insight-type">
                  {insight.type}
                </span>

                <span class="insight-arrow" aria-hidden="true">
                  →
                </span>

              </div>

              <h3>
                {insight.title}
              </h3>

              <p>
                {insight.description}
              </p>

              <a href={insight.href} class="insight-link">
                Read insight
                <span aria-hidden="true">→</span>
              </a>

            </article>
          ))}

        </div>

      </div>
    </section>


    <!-- =========================================
         TECHNICAL GUIDES
    ========================================== -->

    <section class="technical-section" id="technical-guides">
      <div class="container">

        <div class="technical-layout">

          <div class="technical-intro">

            <Eyebrow
              text="Technical Guides"
              variant="path"
            />

            <h2>
              Engineering guidance
              for complex identity
              environments.
            </h2>

            <p>
              IAM becomes difficult when identity touches everything.
              Our technical guidance focuses on the architecture,
              integration patterns, and engineering decisions that
              make enterprise identity manageable.
            </p>

            <a href="#latest" class="button button-secondary">
              <span>Explore Technical Content</span>
              <span aria-hidden="true">→</span>
            </a>

          </div>


          <div class="technical-list">

            <a href="#" class="technical-item">

              <div class="technical-item-content">

                <span class="technical-label">
                  Architecture
                </span>

                <h3>
                  Identity Architecture Reference Models
                </h3>

                <p>
                  Establishing the architectural foundations
                  for scalable enterprise identity.
                </p>

              </div>

              <span class="technical-arrow" aria-hidden="true">
                →
              </span>

            </a>


            <a href="#" class="technical-item">

              <div class="technical-item-content">

                <span class="technical-label">
                  Lifecycle
                </span>

                <h3>
                  Designing Identity Lifecycle Workflows
                </h3>

                <p>
                  Connecting workforce events, identity data,
                  provisioning, and access decisions.
                </p>

              </div>

              <span class="technical-arrow" aria-hidden="true">
                →
              </span>

            </a>


            <a href="#" class="technical-item">

              <div class="technical-item-content">

                <span class="technical-label">
                  Federation
                </span>

                <h3>
                  Federation and Application Integration
                </h3>

                <p>
                  Creating consistent authentication and trust
                  patterns across enterprise applications.
                </p>

              </div>

              <span class="technical-arrow" aria-hidden="true">
                →
              </span>

            </a>


            <a href="#" class="technical-item">

              <div class="technical-item-content">

                <span class="technical-label">
                  Modernization
                </span>

                <h3>
                  Modernizing Legacy Identity Environments
                </h3>

                <p>
                  Moving from fragmented identity infrastructure
                  toward a more deliberate target architecture.
                </p>

              </div>

              <span class="technical-arrow" aria-hidden="true">
                →
              </span>

            </a>

          </div>

        </div>

      </div>
    </section>


    <!-- =========================================
         CASE STUDIES
    ========================================== -->

    <section class="case-studies-section" id="case-studies">
      <div class="container">

        <div class="section-header">

          <Eyebrow
            text="Case Studies"
            variant="bracket"
          />

          <h2>
            Engineering identity
            <span class="text-gradient"> in the real world.</span>
          </h2>

          <p>
            Selected engagement stories will show how Isocore
            approaches complex identity environments, from
            architecture and modernization through implementation
            and ongoing engineering.
          </p>

        </div>


        <div class="case-study-placeholder">

          <div class="case-study-placeholder-content">

            <span class="case-study-label">
              Selected engagements
            </span>

            <h3>
              Case studies are coming soon.
            </h3>

            <p>
              We are building a library of enterprise identity
              engineering engagements covering modernization,
              architecture, integration, and operational support.
            </p>

          </div>


          <div class="case-study-placeholder-side">

            <span>Strategy</span>
            <span>Architecture</span>
            <span>Modernization</span>
            <span>Integration</span>
            <span>Operations</span>

          </div>

        </div>

      </div>
    </section>


    <!-- =========================================
         PERSPECTIVE
    ========================================== -->

    <section class="perspective-section">
      <div class="container">

        <div class="perspective-inner">

          <Eyebrow
            text="Isocore Perspective"
            variant="bracket"
          />

          <h2 style="color: aliceblue;"">
            Build identity as infrastructure.
          </h2>

          <p style="color: var(--color-white);">
            Strong identity programs are not defined by the number
            of platforms they deploy. They are defined by how well
            identity works across the enterprise.
          </p>

          <a href="/contact" class="button button-primary">
            <span>Talk to Isocore</span>
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </div>
    </section>


    

  </main>
</BaseLayout>


<style>

/* =========================================
   HERO
========================================= */

.insights-hero {
  position: relative;

  min-height: 560px;

  display: flex;
  align-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #f7fafc 0%,
      #edf8fc 52%,
      #eef5ff 100%
    );
}

.insights-hero-inner {
  position: relative;
  z-index: 1;

  padding-top: 110px;
  padding-bottom: 100px;
}

.hero-copy {
  max-width: 820px;
}

.hero-copy h1 {
  max-width: 820px;

  margin-bottom: 28px;

  font-size:
    clamp(3.2rem, 6.5vw, 5.5rem);
}

.hero-copy p {
  max-width: 680px;

  margin-bottom: 0;

  font-size: 1.12rem;
  line-height: 1.75;
}


/* =========================================
   HERO GRID
========================================= */

.hero-grid {
  position: absolute;

  inset: 0;

  opacity: 0.45;

  background-image:
    linear-gradient(
      rgba(0, 114, 255, 0.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(0, 114, 255, 0.055) 1px,
      transparent 1px
    );

  background-size: 72px 72px;

  mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      black 30%,
      black 75%,
      transparent 100%
    );
}


/* =========================================
   CATEGORY NAV
========================================= */

.category-section {
  background: var(--color-white);

  border-bottom: 1px solid var(--color-border);
}

.category-nav {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  border-left: 1px solid var(--color-border);
}

.category-link {
  position: relative;

  display: flex;
  flex-direction: column;

  gap: 5px;

  min-height: 92px;

  justify-content: center;

  padding: 18px 26px;

  border-right: 1px solid var(--color-border);

  color: var(--color-text);

  transition:
    background var(--transition-normal),
    color var(--transition-normal);
}

.category-link span {
  font-family: var(--font-display);

  font-size: 0.95rem;
  font-weight: 700;
}

.category-link small {
  color: var(--color-text-muted);

  font-family: var(--font-mono);

  font-size: 0.62rem;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}

.category-link::after {
  content: "";

  position: absolute;

  left: 26px;
  right: 26px;
  bottom: -1px;

  height: 2px;

  background: var(--color-primary);

  transform: scaleX(0);
  transform-origin: left;

  transition:
    transform var(--transition-normal);
}

.category-link:hover {
  background: var(--color-surface-raised);
}

.category-link:hover::after,
.category-link.is-active::after {
  transform: scaleX(1);
}

.category-link.is-active span {
  color: var(--color-primary);
}


/* =========================================
   FEATURED
========================================= */

.featured-section {
  padding-block: 110px;

  background: var(--color-bg);
}

.featured-card {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(360px, 0.85fr);

  overflow: hidden;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-lg);

  background: var(--color-white);

  box-shadow: var(--shadow-card);
}

.featured-content {
  padding: 56px;
}

.content-meta {
  display: flex;
  align-items: center;

  gap: 10px;

  margin-bottom: 24px;
}

.content-meta span {
  color: var(--color-primary);

  font-family: var(--font-mono);

  font-size: 0.63rem;
  font-weight: 600;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.content-meta span + span {
  padding-left: 10px;

  border-left: 1px solid var(--color-border-strong);

  color: var(--color-text-muted);
}

.featured-content h3 {
  max-width: 680px;

  margin-bottom: 22px;

  font-size:
    clamp(2rem, 3.2vw, 3rem);

  line-height: 1.08;
}

.featured-content p {
  max-width: 650px;

  font-size: 0.98rem;

  line-height: 1.75;
}

.featured-content .button {
  margin-top: 18px;
}


/* =========================================
   FEATURED VISUAL
========================================= */

.featured-visual {
  position: relative;

  min-height: 420px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #061426 0%,
      #0a2a47 58%,
      #006eaa 100%
    );
}

.featured-visual::before {
  content: "";

  position: absolute;

  width: 340px;
  height: 340px;

  border-radius: 50%;

  background: rgba(0, 180, 219, 0.14);

  filter: blur(80px);
}

.architecture-frame {
  position: relative;
  z-index: 1;

  width: 270px;

  display: flex;
  flex-direction: column;

  align-items: center;

  gap: 0;
}

.architecture-node {
  width: 190px;

  padding: 14px 18px;

  border: 1px solid rgba(255, 255, 255, 0.2);

  border-radius: 6px;

  background: rgba(255, 255, 255, 0.06);

  color: var(--color-white);

  font-family: var(--font-mono);

  font-size: 0.68rem;

  letter-spacing: 0.08em;

  text-align: center;

  text-transform: uppercase;
}

.node-identity {
  border-color: rgba(0, 180, 219, 0.6);

  background:
    linear-gradient(
      135deg,
      rgba(0, 114, 255, 0.28),
      rgba(0, 180, 219, 0.16)
    );

  box-shadow:
    0 0 30px rgba(0, 180, 219, 0.12);
}

.architecture-line {
  width: 1px;
  height: 34px;

  background:
    linear-gradient(
      to bottom,
      rgba(0, 180, 219, 0.1),
      rgba(0, 180, 219, 0.8)
    );
}


/* =========================================
   LATEST
========================================= */

.latest-section {
  padding-block: 110px;

  background: var(--color-white);
}

.section-header-row {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 50px;
}

.section-header-row > p {
  max-width: 390px;

  margin-bottom: 6px;
}

.insights-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.insight-card {
  display: flex;
  flex-direction: column;

  min-height: 330px;

  padding: 30px;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-md);

  background: var(--color-white);

  transition:
    transform var(--transition-normal),
    border-color var(--transition-normal),
    box-shadow var(--transition-normal);
}

.insight-card:hover {
  transform: translateY(-4px);

  border-color: var(--color-border-strong);

  box-shadow: var(--shadow-card-hover);
}

.insight-card-top {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-bottom: 38px;
}

.insight-type {
  color: var(--color-primary);

  font-family: var(--font-mono);

  font-size: 0.62rem;
  font-weight: 600;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.insight-arrow {
  color: var(--color-cyan);

  font-size: 1.1rem;
}

.insight-card h3 {
  margin-bottom: 14px;

  font-size: 1.28rem;

  line-height: 1.2;
}

.insight-card p {
  margin-bottom: 28px;

  font-size: 0.88rem;

  line-height: 1.7;
}

.insight-link {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  margin-top: auto;

  color: var(--color-text);

  font-family: var(--font-sans);

  font-size: 0.78rem;
  font-weight: 700;

  transition:
    color var(--transition-fast);
}

.insight-link span {
  transition:
    transform var(--transition-fast);
}

.insight-link:hover {
  color: var(--color-primary);
}

.insight-link:hover span {
  transform: translateX(3px);
}


/* =========================================
   TECHNICAL GUIDES
========================================= */

.technical-section {
  padding-block: 110px;

  background: var(--color-surface-raised);
}

.technical-layout {
  display: grid;

  grid-template-columns:
    minmax(300px, 0.8fr)
    minmax(0, 1.2fr);

  gap: 100px;

  align-items: start;
}

.technical-intro h2 {
  margin-bottom: 24px;
}

.technical-intro > p {
  max-width: 500px;

  margin-bottom: 30px;

  font-size: 0.95rem;

  line-height: 1.75;
}

.technical-list {
  border-top: 1px solid var(--color-border);
}

.technical-item {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 30px;

  padding: 28px 0;

  border-bottom: 1px solid var(--color-border);

  transition:
    padding-left var(--transition-normal);
}

.technical-item:hover {
  padding-left: 8px;
}

.technical-item-content {
  min-width: 0;
}

.technical-label {
  display: block;

  margin-bottom: 9px;

  color: var(--color-primary);

  font-family: var(--font-mono);

  font-size: 0.6rem;
  font-weight: 600;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.technical-item h3 {
  margin-bottom: 7px;

  font-size: 1.12rem;
}

.technical-item p {
  margin-bottom: 0;

  font-size: 0.82rem;

  line-height: 1.6;
}

.technical-arrow {
  flex-shrink: 0;

  color: var(--color-primary);

  font-size: 1.1rem;

  transition:
    transform var(--transition-fast);
}

.technical-item:hover .technical-arrow {
  transform: translateX(4px);
}


/* =========================================
   CASE STUDIES
========================================= */

.case-studies-section {
  padding-block: 110px;

  background: var(--color-white);
}

.case-studies-section .section-header {
  max-width: 760px;
}

.case-studies-section .section-header p {
  max-width: 680px;
}

.case-study-placeholder {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    280px;

  overflow: hidden;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-lg);

  background: var(--color-surface-raised);
}

.case-study-placeholder-content {
  padding: 48px;
}

.case-study-label {
  display: block;

  margin-bottom: 18px;

  color: var(--color-primary);

  font-family: var(--font-mono);

  font-size: 0.62rem;
  font-weight: 600;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.case-study-placeholder h3 {
  margin-bottom: 15px;

  font-size: 1.65rem;
}

.case-study-placeholder p {
  max-width: 650px;

  margin-bottom: 0;

  font-size: 0.9rem;

  line-height: 1.7;
}

.case-study-placeholder-side {
  display: flex;
  flex-direction: column;

  justify-content: center;

  gap: 0;

  padding: 35px;

  border-left: 1px solid var(--color-border);

  background: var(--color-white);
}

.case-study-placeholder-side span {
  padding: 12px 0;

  border-bottom: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 0.62rem;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}

.case-study-placeholder-side span:last-child {
  border-bottom: 0;
}


/* =========================================
   PERSPECTIVE
========================================= */

.perspective-section {
  padding-block: 110px;

  background:
      linear-gradient(
        105deg,
        #008fd0 0%,
        #00b8c8 55%,
        #0a2a6b 100%
      );

  color: var(--color-white);
}

.perspective-inner {
  max-width: 850px;

  margin-inline: auto;

  text-align: center;
}

.perspective-inner :global(.eyebrow) {
  justify-content: center;
}

.perspective-inner h2 {
  color: var(--color-white);

  margin-bottom: 24px;
}

.perspective-inner p {
  max-width: 680px;

  margin-inline: auto;
  margin-bottom: 30px;

  color: #a9bbcd;

  font-size: 1rem;

  line-height: 1.75;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1000px) {

  .featured-card {
    grid-template-columns: 1fr;
  }

  .featured-visual {
    min-height: 320px;
  }

  .insights-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .technical-layout {
    grid-template-columns: 1fr;

    gap: 55px;
  }

}

@media (max-width: 760px) {

  .insights-hero {
    min-height: auto;
  }

  .insights-hero-inner {
    padding-top: 150px;
    padding-bottom: 80px;
  }

  .category-nav {
