---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
---

<BaseLayout
  title="Implementation & Integration | Isocore Solutions"
  description="Implement identity platforms and integrate applications, directories, authentication systems, provisioning, and enterprise workflows."
>
  <main>
    <!-- HERO -->
    <section class="service-hero">
      <div class="hero-grid"></div>

      <div class="container hero-inner">
        <div class="hero-content">
          <Eyebrow text="Implementation & Integration" variant="bracket" />

          <h1>
            Turn identity architecture into
            <span class="text-gradient">working infrastructure.</span>
          </h1>

          <p class="hero-description">
            Implement identity platforms and connect them to the applications,
            directories, authentication systems, and workflows that make the
            enterprise operate.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="button button-primary">
              Schedule an IAM Assessment
              <span>→</span>
            </a>

            <a href="/services" class="button button-secondary">
              Explore All Services
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT WE SOLVE -->
    <section class="section solve-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="What We Solve" variant="system" />

          <h2>Connect identity to the enterprise.</h2>

          <p>
            Identity platforms create value when they are connected to the
            applications, authentication systems, directories, and business
            processes that depend on them. We engineer those connections
            around the target architecture.
          </p>
        </div>

        <div class="solve-grid">
          <div class="solve-item">
            <h3>IAM Platform Implementation</h3>
            <p>
              Implement identity platforms around defined architecture,
              security requirements, integration patterns, and operational
              needs.
            </p>
          </div>

          <div class="solve-item">
            <h3>Application Integration</h3>
            <p>
              Connect enterprise applications to identity platforms using
              appropriate authentication, authorization, provisioning, and
              lifecycle patterns.
            </p>
          </div>

          <div class="solve-item">
            <h3>Single Sign-On</h3>
            <p>
              Establish consistent authentication experiences across
              enterprise applications and environments.
            </p>
          </div>

          <div class="solve-item">
            <h3>Multi-Factor Authentication</h3>
            <p>
              Deploy MFA capabilities while accounting for application
              compatibility, user experience, security controls, and
              operational requirements.
            </p>
          </div>

          <div class="solve-item">
            <h3>Provisioning & Lifecycle</h3>
            <p>
              Connect identity platforms to directories, applications, HR
              systems, and business workflows.
            </p>
          </div>

          <div class="solve-item">
            <h3>Enterprise Integrations</h3>
            <p>
              Build identity integrations through APIs and enterprise
              integration patterns where standard platform capabilities are
              insufficient.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="section capabilities-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="Capabilities" variant="line" />

          <h2>Implementation that respects the architecture.</h2>
        </div>

        <div class="capabilities-list">
          <article class="capability-row">
            <div class="capability-content">
              <h3>IAM Platform Implementation</h3>
              <p>
                Configure and implement identity platforms around defined
                architecture, security requirements, integration patterns, and
                operational needs.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Application Onboarding</h3>
              <p>
                Connect enterprise applications to identity platforms through
                appropriate authentication, authorization, provisioning, and
                lifecycle patterns.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Single Sign-On & Federation</h3>
              <p>
                Implement SSO and federation architectures that provide
                consistent and secure access across enterprise applications and
                environments.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>MFA & Authentication</h3>
              <p>
                Deploy modern authentication and MFA capabilities while
                accounting for application compatibility, user experience,
                security controls, and operational requirements.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Provisioning & Lifecycle Integration</h3>
              <p>
                Connect identity platforms to HR, directories, applications,
                and business workflows to support consistent identity lifecycle
                management.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Identity APIs & Integrations</h3>
              <p>
                Build and integrate identity services through APIs and
                enterprise integration patterns where standard platform
                capabilities are insufficient.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section class="section approach-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="How We Approach It" variant="path" />

          <h2>Build, integrate, validate.</h2>

          <p>
            Implementation should translate architecture into reliable
            infrastructure. We work across the technical dependencies required
            to make identity operate in production.
          </p>
        </div>

        <div class="approach-grid">
          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Architecture</h3>
            <p>
              Translate target identity architecture into implementation
              requirements, integration patterns, technical dependencies, and
              operational considerations.
            </p>
          </article>

          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Integration</h3>
            <p>
              Connect identity platforms with directories, applications,
              authentication systems, and enterprise workflows.
            </p>
          </article>

          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Validation</h3>
            <p>
              Test authentication, authorization, provisioning, lifecycle
              behavior, resilience, and operational processes before production.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="section technology-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="Technology Context" variant="signal" />

          <h2>Identity connected across the enterprise.</h2>

          <p>
            Successful implementation requires more than configuring an IAM
            platform. We consider the systems, protocols, applications, and
            workflows surrounding identity.
          </p>
        </div>

        <div class="technology-grid">
          <div class="technology-card">
            <span>01</span>
            <h3>IAM Platforms</h3>
            <p>
              Identity platforms, access services, policy engines, and
              administrative capabilities.
            </p>
          </div>

          <div class="technology-card">
            <span>02</span>
            <h3>Applications</h3>
            <p>
              Enterprise applications, SaaS platforms, custom applications, and
              application access patterns.
            </p>
          </div>

          <div class="technology-card">
            <span>03</span>
            <h3>Authentication</h3>
            <p>
              SSO, federation, MFA, authentication protocols, and access
              policies.
            </p>
          </div>

          <div class="technology-card">
            <span>04</span>
            <h3>Directories</h3>
            <p>
              Directory services, identity stores, synchronization, and
              enterprise directory infrastructure.
            </p>
          </div>

          <div class="technology-card">
            <span>05</span>
            <h3>Provisioning</h3>
            <p>
              Account provisioning, deprovisioning, lifecycle events, and
              identity synchronization.
            </p>
          </div>

          <div class="technology-card">
            <span>06</span>
            <h3>Integration</h3>
            <p>
              APIs, connectors, workflows, automation, and enterprise
              integration patterns.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ENGAGEMENT -->
    <section class="section engagement-section">
      <div class="container">
        <div class="engagement-panel">
          <div class="engagement-content">
            <Eyebrow text="Engagement" variant="bracket" />

            <h2>From architecture to operation.</h2>

            <p>
              Whether you're implementing a new IAM platform, onboarding
              applications, modernizing authentication, or connecting identity
              across a hybrid environment, Isocore can help turn the
              architecture into reliable enterprise infrastructure.
            </p>

            <div class="engagement-actions">
              <a href="/contact" class="button button-primary">
                Schedule an IAM Assessment
                <span>→</span>
              </a>

              <a href="/services" class="button button-secondary">
                Explore All Services
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

   
  </main>
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: center;
    padding-top: 150px;
    padding-bottom: 110px;
    background: var(--color-bg);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(0, 114, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 114, 255, 0.055) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 880px;
  }

  .hero-content :global(.eyebrow-bracket) {
    color: var(--color-cyan);
  }

  .hero-content :global(.eyebrow-bracket + span) {
    color: var(--color-primary);
  }

  .hero-content h1 {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .hero-description {
    max-width: 720px;
    margin-bottom: 36px;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .hero-actions,
  .engagement-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    transition:
      background var(--transition-normal),
      border-color var(--transition-normal),
      color var(--transition-normal),
      transform var(--transition-normal);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    background: var(--color-white);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .solve-section {
    background: var(--color-white);
  }

  .section-header {
    max-width: 760px;
  }

  .solve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .solve-item {
    min-height: 230px;
    padding: 32px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .solve-item h3 {
    margin-bottom: 14px;
  }

  .solve-item p {
    margin-bottom: 0;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .capabilities-section {
    background: var(--color-bg);
  }

  .capabilities-list {
    border-top: 1px solid var(--color-border);
  }

  .capability-row {
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
    transition:
      padding-left var(--transition-normal),
      background var(--transition-normal);
  }

  .capability-row:hover {
    padding-left: 18px;
    background: rgba(0, 114, 255, 0.025);
  }

  .capability-content h3 {
    margin-bottom: 10px;
  }

  .capability-content p {
    max-width: 760px;
    margin-bottom: 0;
  }

  .approach-section {
    background: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .approach-card {
    padding: 34px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .approach-line {
    display: block;
    width: 42px;
    height: 2px;
    margin-bottom: 28px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .approach-card h3 {
    margin-bottom: 14px;
  }

  .approach-card p {
    margin-bottom: 0;
  }

  .technology-section {
    background: var(--color-bg);
  }

  .technology-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .technology-card {
    min-height: 220px;
    padding: 30px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .technology-card > span {
    display: block;
    margin-bottom: 24px;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .technology-card h3 {
    margin-bottom: 10px;
  }

  .technology-card p {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .engagement-section {
    background: var(--color-white);
  }

  .engagement-panel {
    position: relative;
    overflow: hidden;
    padding: 72px;
    background: linear-gradient(
      135deg,
      #061426 0%,
      #0a2a4a 55%,
      #006b8f 100%
    );
    color: var(--color-white);
  }

  .engagement-panel::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    right: -160px;
    top: -180px;
    border-radius: 50%;
    background: var(--color-cyan);
    opacity: 0.08;
    filter: blur(70px);
  }

  .engagement-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .engagement-content :global(.eyebrow-bracket) {
    color: rgba(255, 255, 255, 0.72);
  }

  .engagement-content :global(.eyebrow-bracket + span) {
    color: var(--color-white);
  }

  .engagement-content h2 {
    color: var(--color-white);
    margin-bottom: 22px;
  }

  .engagement-content p {
    max-width: 720px;
    margin-bottom: 32px;
    color: rgba(255, 255, 255, 0.76);
  }

  .engagement-content .button-secondary {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-white);
  }

  .engagement-content .button-secondary:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 900px) {
    .solve-grid,
    .technology-grid,
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .engagement-panel {
      padding: 52px 36px;
    }
  }

  @media (max-width: 700px) {
    .service-hero {
      min-height: auto;
      padding-top: 130px;
      padding-bottom: 80px;
    }

    .hero-description {
      font-size: 1rem;
    }

    .solve-grid,
    .technology-grid,
    .approach-grid {
      grid-template-columns: 1fr;
    }

    .solve-item,
    .technology-card {
      min-height: auto;
    }

    .engagement-panel {
      padding: 42px 24px;
    }

    .button {
      width: 100%;
    }
  }
</style>