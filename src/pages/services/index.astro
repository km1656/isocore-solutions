---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Eyebrow from "../../components/Eyebrow.astro";
---

<BaseLayout
  title="Services | Isocore Solutions"
  description="Enterprise identity strategy, modernization, implementation, integration, and managed identity services from Isocore Solutions."
>
  <main>
    <!-- HERO -->
    <section class="services-hero">
      <div class="hero-grid"></div>

      <div class="container hero-inner">
        <div class="hero-content">
          <Eyebrow text="Identity Services" variant="bracket" />

          <h1>
            Identity engineering for
            <span class="text-gradient"> the enterprise.</span>
          </h1>

          <p class="hero-description">
            From identity strategy and architecture through modernization,
            implementation, integration, and ongoing support, Isocore helps
            organizations build identity environments designed to operate and
            evolve.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="button button-primary">
              Schedule an IAM Assessment
              <span>→</span>
            </a>

            <a href="#services" class="button button-secondary">
              Explore Services
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES OVERVIEW -->
    <section class="section overview-section" id="services">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="What We Do" variant="system" />

          <h2>
            A complete identity engineering
            <span class="text-gradient"> capability.</span>
          </h2>

          <p>
            Enterprise identity is not a single platform or project. It is an
            interconnected architecture spanning strategy, infrastructure,
            applications, authentication, governance, and operations.
          </p>
        </div>

        <div class="service-list">
          <a
            href="/services/iam-strategy-architecture"
            class="service-row"
          >
            <div class="service-row-content">
              <h3>IAM Strategy & Architecture</h3>

              <p>
                Establish the identity architecture, strategy, and roadmap
                required to support enterprise security, access, and
                long-term growth.
              </p>

              <span class="service-link">
                Explore Strategy & Architecture
                <span>→</span>
              </span>
            </div>
          </a>

          <a
            href="/services/identity-modernization"
            class="service-row"
          >
            <div class="service-row-content">
              <h3>Identity Modernization</h3>

              <p>
                Transform legacy directories and identity infrastructure
                through structured modernization, migration, consolidation,
                and hybrid identity strategies.
              </p>

              <span class="service-link">
                Explore Identity Modernization
                <span>→</span>
              </span>
            </div>
          </a>

          <a
            href="/services/implementation-integration"
            class="service-row"
          >
            <div class="service-row-content">
              <h3>Implementation & Integration</h3>

              <p>
                Turn identity architecture into working infrastructure by
                implementing platforms and connecting applications,
                directories, authentication, provisioning, and workflows.
              </p>

              <span class="service-link">
                Explore Implementation & Integration
                <span>→</span>
              </span>
            </div>
          </a>

          <a
            href="/services/managed-identity-support"
            class="service-row"
          >
            <div class="service-row-content">
              <h3>Managed Identity & Support</h3>

              <p>
                Keep identity environments resilient through ongoing platform
                support, troubleshooting, operational engineering,
                optimization, and continuous improvement.
              </p>

              <span class="service-link">
                Explore Managed Identity & Support
                <span>→</span>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- DELIVERY MODEL -->
    <section class="section delivery-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="How We Work" variant="path" />

          <h2>
            Architecture first.
            <span class="text-gradient"> Execution aligned.</span>
          </h2>

          <p>
            Our work connects strategic decisions to technical execution. Each
            engagement is shaped around the organization's existing environment,
            target state, dependencies, and operational requirements.
          </p>
        </div>

        <div class="delivery-grid">
          <article class="delivery-card">
            <span class="delivery-line"></span>

            <h3>Understand</h3>

            <p>
              Establish a clear view of the current identity environment,
              business requirements, technical dependencies, and operational
              constraints.
            </p>
          </article>

          <article class="delivery-card">
            <span class="delivery-line"></span>

            <h3>Architect</h3>

            <p>
              Define the target identity architecture, platform strategy,
              integration patterns, security requirements, and modernization
              path.
            </p>
          </article>

          <article class="delivery-card">
            <span class="delivery-line"></span>

            <h3>Engineer</h3>

            <p>
              Implement and integrate identity capabilities across platforms,
              applications, directories, authentication systems, and workflows.
            </p>
          </article>

          <article class="delivery-card">
            <span class="delivery-line"></span>

            <h3>Evolve</h3>

            <p>
              Support the environment after implementation through operational
              expertise, optimization, troubleshooting, and continuous
              improvement.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- CAPABILITY MAP -->
    <section class="section capability-section">
      <div class="container">
        <div class="capability-layout">
          <div class="capability-intro">
            <Eyebrow text="Enterprise Identity" variant="signal" />

            <h2>
              Identity is an
              <span class="text-gradient"> interconnected system.</span>
            </h2>

            <p>
              Our services are designed to work across the identity ecosystem,
              rather than treating individual platforms or capabilities in
              isolation.
            </p>

            <a href="/platforms" class="text-link">
              Explore Technology Platforms
              <span>→</span>
            </a>
          </div>

          <div class="capability-map">
            <div class="map-node map-node-primary">
              <span>Identity</span>
              <small>Enterprise Foundation</small>
            </div>

            <div class="map-connection connection-one"></div>
            <div class="map-connection connection-two"></div>
            <div class="map-connection connection-three"></div>
            <div class="map-connection connection-four"></div>

            <div class="map-node map-node-top">
              <span>Access</span>
              <small>Authentication & Authorization</small>
            </div>

            <div class="map-node map-node-right">
              <span>Applications</span>
              <small>Integration & Lifecycle</small>
            </div>

            <div class="map-node map-node-bottom">
              <span>Directories</span>
              <small>Identity Infrastructure</small>
            </div>

            <div class="map-node map-node-left">
              <span>Governance</span>
              <small>Policy & Control</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY ISOCORE -->
    <section class="section perspective-section">
      <div class="container">
        <div class="perspective-panel">
          <div class="perspective-content">
            <Eyebrow text="Isocore Perspective" variant="bracket" />

            <h2>
              Build identity as
              <span class="text-gradient"> infrastructure.</span>
            </h2>

            <p>
              Identity sits at the intersection of security, infrastructure,
              applications, and users. Our approach treats it as foundational
              enterprise infrastructure — something that needs clear
              architecture, disciplined engineering, and long-term operational
              ownership.
            </p>

            <p>
              That means designing beyond the immediate project and considering
              how identity will operate, integrate, scale, and evolve over
              time.
            </p>
          </div>

          <div class="perspective-lines" aria-hidden="true">
            <div class="line-horizontal"></div>
            <div class="line-vertical"></div>
            <div class="line-node node-a"></div>
            <div class="line-node node-b"></div>
            <div class="line-node node-c"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <CTASection />
  </main>
</BaseLayout>

<style>
  /* --------------------------------
     HERO
  -------------------------------- */

  .services-hero {
    position: relative;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: center;
    padding-top: 150px;
    padding-bottom: 110px;
    background: var(--color-bg);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    pointer-events: none;

    background-image:
      linear-gradient(
        rgba(0, 114, 255, 0.055) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 114, 255, 0.055) 1px,
        transparent 1px
      );

    background-size: 72px 72px;

    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 85%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 880px;
  }

  .hero-content :global(.eyebrow-bracket) {
    color: var(--color-cyan);
  }

  .hero-content :global(.eyebrow-bracket + span) {
    color: var(--color-primary);
  }

  .hero-content h1 {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .hero-description {
    max-width: 730px;
    margin-bottom: 36px;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* --------------------------------
     BUTTONS
  -------------------------------- */

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    min-height: 52px;
    padding: 0 22px;

    border: 1px solid transparent;
    border-radius: var(--radius-sm);

    font-size: 0.88rem;
    font-weight: 700;

    transition:
      background var(--transition-normal),
      border-color var(--transition-normal),
      color var(--transition-normal),
      transform var(--transition-normal);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    background: var(--color-white);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* --------------------------------
     OVERVIEW
  -------------------------------- */

  .overview-section {
    background: var(--color-white);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: 52px;
  }

  .section-header h2 {
    margin-bottom: 20px;
  }

  .section-header p {
    max-width: 700px;
    margin-bottom: 0;
  }

  .service-list {
    border-top: 1px solid var(--color-border);
  }

  .service-row {
    position: relative;
    display: block;
    padding: 42px 40px 42px 0;

    border-bottom: 1px solid var(--color-border);

    transition:
      padding-left var(--transition-normal),
      background var(--transition-normal);
  }

  .service-row::after {
    content: "→";

    position: absolute;
    top: 42px;
    right: 4px;

    color: var(--color-primary);
    font-size: 1.2rem;

    transition:
      transform var(--transition-normal),
      color var(--transition-normal);
  }

  .service-row:hover {
    padding-left: 18px;
    background: rgba(0, 114, 255, 0.025);
  }

  .service-row:hover::after {
    transform: translateX(5px);
    color: var(--color-cyan);
  }

  .service-row-content {
    max-width: 820px;
  }

  .service-row h3 {
    margin-bottom: 12px;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }

  .service-row p {
    max-width: 760px;
    margin-bottom: 18px;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    color: var(--color-primary);

    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .service-link span {
    transition: transform var(--transition-fast);
  }

  .service-row:hover .service-link span {
    transform: translateX(4px);
  }

  /* --------------------------------
     DELIVERY
  -------------------------------- */

  .delivery-section {
    background: var(--color-bg);
  }

  .delivery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .delivery-card {
    min-height: 280px;
    padding: 32px;

    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);

    background: var(--color-white);
  }

  .delivery-line {
    display: block;

    width: 42px;
    height: 2px;

    margin-bottom: 32px;

    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .delivery-card h3 {
    margin-bottom: 14px;
  }

  .delivery-card p {
    margin-bottom: 0;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* --------------------------------
     CAPABILITY MAP
  -------------------------------- */

  .capability-section {
    background: var(--color-white);
  }

  .capability-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 80px;
    align-items: center;
  }

  .capability-intro {
    max-width: 520px;
  }

  .capability-intro h2 {
    margin-bottom: 22px;
  }

  .capability-intro p {
    margin-bottom: 28px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    color: var(--color-primary);

    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .text-link span {
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  .capability-map {
    position: relative;

    min-height: 500px;

    border: 1px solid var(--color-border);

    background:
      linear-gradient(
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      ),
      var(--color-bg);

    background-size: 40px 40px;
  }

  .map-node {
    position: absolute;

    width: 180px;
    min-height: 88px;

    padding: 18px;

    border: 1px solid var(--color-border-strong);

    background: rgba(255, 255, 255, 0.94);

    box-shadow: var(--shadow-card);

    z-index: 2;
  }

  .map-node span {
    display: block;

    margin-bottom: 5px;

    color: var(--color-text);

    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .map-node small {
    display: block;

    color: var(--color-text-muted);

    font-size: 0.68rem;
    line-height: 1.4;
  }

  .map-node-primary {
    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    width: 210px;

    border-color: var(--color-primary);

    background: var(--color-dark);
  }

  .map-node-primary span {
    color: var(--color-white);
  }

  .map-node-primary small {
    color: #a9bbcd;
  }

  .map-node-top {
    top: 48px;
    left: 50%;

    transform: translateX(-50%);
  }

  .map-node-right {
    top: 50%;
    right: 36px;

    transform: translateY(-50%);
  }

  .map-node-bottom {
    bottom: 48px;
    left: 50%;

    transform: translateX(-50%);
  }

  .map-node-left {
    top: 50%;
    left: 36px;

    transform: translateY(-50%);
  }

  .map-connection {
    position: absolute;

    background: linear-gradient(
      90deg,
      var(--color-border-strong),
      var(--color-cyan)
    );

    opacity: 0.75;
    z-index: 1;
  }

  .connection-one {
    width: 1px;
    height: 110px;

    top: 50px;
    left: 50%;
  }

  .connection-two {
    width: 115px;
    height: 1px;

    top: 50%;
    right: 190px;
  }

  .connection-three {
    width: 1px;
    height: 110px;

    bottom: 50px;
    left: 50%;
  }

  .connection-four {
    width: 115px;
    height: 1px;

    top: 50%;
    left: 190px;
  }

  /* --------------------------------
     PERSPECTIVE
  -------------------------------- */

  .perspective-section {
    background: var(--color-bg);
  }

  .perspective-panel {
    position: relative;
    overflow: hidden;

    min-height: 460px;

    display: flex;
    align-items: center;

    padding: 72px;

    background:
      radial-gradient(
        circle at 85% 50%,
        rgba(0, 180, 219, 0.12),
        transparent 32%
      ),
      var(--color-dark);

    color: var(--color-white);
  }

  .perspective-content {
    position: relative;
    z-index: 2;

    max-width: 700px;
  }

  .perspective-content :global(.eyebrow-bracket) {
    color: rgba(255, 255, 255, 0.7);
  }

  .perspective-content :global(.eyebrow-bracket + span) {
    color: var(--color-white);
  }

  .perspective-content h2 {
    margin-bottom: 22px;
    color: var(--color-white);
  }

  .perspective-content p {
    max-width: 680px;

    color: #a9bbcd;

    line-height: 1.8;
  }

  .perspective-lines {
    position: absolute;

    width: 430px;
    height: 430px;

    right: -80px;
    top: 50%;

    transform: translateY(-50%);

    opacity: 0.7;
  }

  .line-horizontal {
    position: absolute;

    width: 100%;
    height: 1px;

    top: 50%;

    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 180, 219, 0.7)
    );
  }

  .line-vertical {
    position: absolute;

    width: 1px;
    height: 100%;

    left: 50%;

    background: linear-gradient(
      180deg,
      transparent,
      rgba(0, 180, 219, 0.5),
      transparent
    );
  }

  .line-node {
    position: absolute;

    width: 10px;
    height: 10px;

    border: 2px solid var(--color-cyan);
    border-radius: 50%;

    background: var(--color-dark);

    box-shadow:
      0 0 0 5px rgba(0, 180, 219, 0.08),
      0 0 20px rgba(0, 180, 219, 0.35);
  }

  .node-a {
    top: calc(50% - 5px);
    left: 20%;
  }

  .node-b {
    top: 25%;
    left: calc(50% - 5px);
  }

  .node-c {
    top: 70%;
    left: calc(50% - 5px);
  }

  /* --------------------------------
     RESPONSIVE
  -------------------------------- */

  @media (max-width: 1000px) {
    .delivery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .capability-layout {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 700px) {
    .services-hero {
      min-height: auto;
      padding-top: 130px;
      padding-bottom: 80px;
    }

    .hero-description {
      font-size: 1rem;
    }

    .service-row {
      padding: 32px 32px 32px 0;
    }

    .service-row::after {
      top: 32px;
    }

    .delivery-grid {
      grid-template-columns: 1fr;
    }

    .delivery-card {
      min-height: auto;
    }

    .capability-map {
      min-height: 460px;
    }

    .map-node {
      width: 145px;
    }

    .map-node-primary {
      width: 170px;
    }

    .map-node-right {
      right: 16px;
    }

    .map-node-left {
      left: 16px;
    }

    .connection-two {
      right: 150px;
    }

    .connection-four {
      left: 150px;
    }

    .perspective-panel {
      min-height: auto;
      padding: 48px 28px;
    }

    .perspective-lines {
      width: 260px;
      height: 260px;

      right: -120px;
      top: 70%;
    }

    .button {
      width: 100%;
    }
  }
</style>