---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Eyebrow from "../../components/Eyebrow.astro";
---

<BaseLayout
  title="Identity Modernization | Isocore Solutions"
  description="Modernize legacy identity infrastructure through structured migration, integration, directory transformation, and hybrid identity strategies."
>
  <main>
    <!-- HERO -->
    <section class="service-hero">
      <div class="hero-grid"></div>

      <div class="container hero-inner">
        <div class="hero-content">
          <Eyebrow text="Identity Modernization" variant="bracket" />

          <h1>
            Modernize identity
            <span class="text-gradient">without losing control.</span>
          </h1>

          <p class="hero-description">
            Transform legacy directories and identity infrastructure through
            structured modernization, migration, integration, and hybrid
            identity strategies.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="button button-primary">
              Schedule an IAM Assessment
              <span>→</span>
            </a>

            <a href="/services" class="button button-secondary">
              Explore All Services
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT WE SOLVE -->
    <section class="section solve-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="What We Solve" variant="system" />

          <h2>
            Modern identity requires more than replacing legacy technology.
          </h2>

          <p>
            Identity modernization is an architectural transition. We help
            organizations understand existing dependencies, define a practical
            target state, and move toward modern identity capabilities without
            unnecessary disruption.
          </p>
        </div>

        <div class="solve-grid">
          <div class="solve-item">
            <h3>Aging Directory Infrastructure</h3>
            <p>
              Modernize directory environments that have become difficult to
              maintain, scale, secure, or integrate.
            </p>
          </div>

          <div class="solve-item">
            <h3>Fragmented Identity Environments</h3>
            <p>
              Establish a more consistent identity architecture across
              disconnected directories, platforms, and applications.
            </p>
          </div>

          <div class="solve-item">
            <h3>Legacy Authentication</h3>
            <p>
              Transition legacy authentication patterns toward modern,
              centralized, and more adaptable access models.
            </p>
          </div>

          <div class="solve-item">
            <h3>Hybrid Cloud Requirements</h3>
            <p>
              Design identity architectures that connect on-premises
              infrastructure with modern cloud identity capabilities.
            </p>
          </div>

          <div class="solve-item">
            <h3>Identity Migrations</h3>
            <p>
              Plan identity migrations around application dependencies,
              authentication requirements, users, data, and operational
              continuity.
            </p>
          </div>

          <div class="solve-item">
            <h3>Platform Consolidation</h3>
            <p>
              Reduce unnecessary identity complexity by rationalizing
              platforms, directories, integrations, and ownership.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="section capabilities-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="Capabilities" variant="line" />

          <h2>Modernization engineered around your environment.</h2>
        </div>

        <div class="capabilities-list">
          <article class="capability-row">
            <div class="capability-content">
              <h3>Directory Modernization</h3>
              <p>
                Modernize directory infrastructure while maintaining
                operational continuity and reducing unnecessary complexity.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Active Directory Transformation</h3>
              <p>
                Assess, restructure, consolidate, and evolve Active Directory
                environments around current enterprise requirements.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Legacy Identity Migration</h3>
              <p>
                Plan and execute identity migrations with attention to
                dependencies, application integration, authentication, and
                user impact.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Hybrid Identity Architecture</h3>
              <p>
                Connect on-premises identity infrastructure with cloud identity
                platforms through deliberate hybrid architecture.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Identity Consolidation</h3>
              <p>
                Reduce fragmented identity environments by establishing
                consistent architecture, ownership, integration, and lifecycle
                practices.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Modern Authentication</h3>
              <p>
                Move organizations toward modern authentication patterns
                including SSO, MFA, federation, and adaptive access.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section class="section approach-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="How We Approach It" variant="path" />

          <h2>A controlled path from legacy to modern.</h2>

          <p>
            Modernization should be deliberate. We establish the architecture
            and dependencies first, then transition identity capabilities in
            controlled stages.
          </p>
        </div>

        <div class="approach-grid">
          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Assess</h3>
            <p>
              Understand the existing identity environment, dependencies,
              applications, authentication patterns, infrastructure, and
              operational constraints.
            </p>
          </article>

          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Design</h3>
            <p>
              Define the target architecture and modernization path around
              enterprise requirements, security, integration, and long-term
              maintainability.
            </p>
          </article>

          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Transition</h3>
            <p>
              Execute migration and transformation through controlled stages
              designed to reduce disruption and maintain operational
              continuity.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="section technology-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="Technology Context" variant="signal" />

          <h2>Modernization across the identity stack.</h2>

          <p>
            Identity modernization touches more than a single platform. We
            consider the surrounding technology ecosystem and its dependencies.
          </p>
        </div>

        <div class="technology-grid">
          <div class="technology-card">
            <span>01</span>
            <h3>Directories</h3>
            <p>
              Directory services, organizational structures, synchronization,
              and identity stores.
            </p>
          </div>

          <div class="technology-card">
            <span>02</span>
            <h3>Identity Platforms</h3>
            <p>
              Enterprise identity platforms, access services, and identity
              management capabilities.
            </p>
          </div>

          <div class="technology-card">
            <span>03</span>
            <h3>Authentication</h3>
            <p>
              Authentication, federation, SSO, MFA, and modern access
              patterns.
            </p>
          </div>

          <div class="technology-card">
            <span>04</span>
            <h3>Cloud</h3>
            <p>
              Cloud identity services and hybrid architectures connecting
              enterprise environments.
            </p>
          </div>

          <div class="technology-card">
            <span>05</span>
            <h3>Applications</h3>
            <p>
              Application dependencies, integrations, authentication
              requirements, and onboarding.
            </p>
          </div>

          <div class="technology-card">
            <span>06</span>
            <h3>Infrastructure</h3>
            <p>
              Supporting infrastructure, operational dependencies, and
              modernization constraints.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ENGAGEMENT -->
    <section class="section engagement-section">
      <div class="container">
        <div class="engagement-panel">
          <div class="engagement-content">
            <Eyebrow text="Engagement" variant="bracket" />

            <h2>Modernize identity with a clear path forward.</h2>

            <p>
              Whether you're consolidating directories, moving toward cloud
              identity, replacing legacy authentication, or transforming a
              hybrid environment, Isocore can help establish a practical
              modernization strategy.
            </p>

            <div class="engagement-actions">
              <a href="/contact" class="button button-primary">
                Schedule an IAM Assessment
                <span>→</span>
              </a>

              <a href="/services" class="button button-secondary">
                Explore All Services
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: center;
    padding-top: 150px;
    padding-bottom: 110px;
    background: var(--color-bg);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(0, 114, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 114, 255, 0.055) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 850px;
  }

  .hero-content :global(.eyebrow-bracket) {
    color: var(--color-cyan);
  }

  .hero-content :global(.eyebrow-bracket + span) {
    color: var(--color-primary);
  }

  .hero-content h1 {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .hero-description {
    max-width: 720px;
    margin-bottom: 36px;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .hero-actions,
  .engagement-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    transition:
      background var(--transition-normal),
      border-color var(--transition-normal),
      color var(--transition-normal),
      transform var(--transition-normal);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    background: var(--color-white);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .solve-section {
    background: var(--color-white);
  }

  .section-header {
    max-width: 760px;
  }

  .solve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .solve-item {
    min-height: 230px;
    padding: 32px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .solve-item h3 {
    margin-bottom: 14px;
  }

  .solve-item p {
    margin-bottom: 0;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .capabilities-section {
    background: var(--color-bg);
  }

  .capabilities-list {
    border-top: 1px solid var(--color-border);
  }

  .capability-row {
    display: grid;
    grid-template-columns: 1fr;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
    transition:
      padding-left var(--transition-normal),
      background var(--transition-normal);
  }

  .capability-row:hover {
    padding-left: 18px;
    background: rgba(0, 114, 255, 0.025);
  }

  .capability-content h3 {
    margin-bottom: 10px;
  }

  .capability-content p {
    max-width: 760px;
    margin-bottom: 0;
  }

  .approach-section {
    background: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .approach-card {
    position: relative;
    padding: 34px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .approach-line {
    display: block;
    width: 42px;
    height: 2px;
    margin-bottom: 28px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .approach-card h3 {
    margin-bottom: 14px;
  }

  .approach-card p {
    margin-bottom: 0;
  }

  .technology-section {
    background: var(--color-bg);
  }

  .technology-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .technology-card {
    min-height: 220px;
    padding: 30px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .technology-card > span {
    display: block;
    margin-bottom: 24px;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .technology-card h3 {
    margin-bottom: 10px;
  }

  .technology-card p {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .engagement-section {
    background: var(--color-white);
  }

  .engagement-panel {
    position: relative;
    overflow: hidden;
    padding: 72px;
    background: linear-gradient(
      135deg,
      #061426 0%,
      #0a2a4a 55%,
      #006b8f 100%
    );
    color: var(--color-white);
  }

  .engagement-panel::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    right: -160px;
    top: -180px;
    border-radius: 50%;
    background: var(--color-cyan);
    opacity: 0.08;
    filter: blur(70px);
  }

  .engagement-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .engagement-content :global(.eyebrow-bracket) {
    color: rgba(255, 255, 255, 0.72);
  }

  .engagement-content :global(.eyebrow-bracket + span) {
    color: var(--color-white);
  }

  .engagement-content h2 {
    color: var(--color-white);
    margin-bottom: 22px;
  }

  .engagement-content p {
    max-width: 720px;
    margin-bottom: 32px;
    color: rgba(255, 255, 255, 0.76);
  }

  .engagement-content .button-secondary {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-white);
  }

  .engagement-content .button-secondary:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 900px) {
    .solve-grid,
    .technology-grid,
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .engagement-panel {
      padding: 52px 36px;
    }
  }

  @media (max-width: 700px) {
    .service-hero {
      min-height: auto;
      padding-top: 130px;
      padding-bottom: 80px;
    }

    .hero-description {
      font-size: 1rem;
    }

    .solve-grid,
    .technology-grid,
    .approach-grid {
      grid-template-columns: 1fr;
    }

    .solve-item,
    .technology-card {
      min-height: auto;
    }

    .engagement-panel {
      padding: 42px 24px;
    }

    .button {
      width: 100%;
    }
  }
</style>