---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CTASection from "../../components/CTASection.astro";

const capabilities = [
  {
    title: "Enterprise IAM Architecture",
    description:
      "Define identity architecture across authentication, authorization, directories, governance, applications, infrastructure, and security controls.",
    tag: "Identity Architecture",
  },
  {
    title: "Identity Strategy & Roadmaps",
    description:
      "Establish practical identity strategies and modernization roadmaps aligned with business priorities, technology direction, and operational requirements.",
    tag: "Strategy",
  },
  {
    title: "Platform Architecture",
    description:
      "Evaluate and architect IAM platforms within the broader enterprise environment, including integration, scalability, resilience, and operational considerations.",
    tag: "Platforms",
  },
  {
    title: "Access Management Architecture",
    description:
      "Design access patterns covering authentication, single sign-on, federation, MFA, authorization, and application access.",
    tag: "Access",
  },
  {
    title: "Identity Governance Architecture",
    description:
      "Establish governance models for identity lifecycle, access certification, provisioning, policy enforcement, and accountability.",
    tag: "Governance",
  },
  {
    title: "Cloud & Hybrid Identity Strategy",
    description:
      "Architect identity environments that span cloud, on-premises infrastructure, directories, applications, and hybrid operating models.",
    tag: "Cloud & Hybrid",
  },
];

const technologyGroups = [
  {
    title: "Identity",
    description:
      "IAM Platforms · Access Management · Identity Governance",
  },
  {
    title: "Directories",
    description:
      "Active Directory · LDAP · Directory Services",
  },
  {
    title: "Authentication",
    description:
      "SSO · MFA · Federation · Adaptive Access",
  },
  {
    title: "Cloud & Hybrid",
    description:
      "Cloud Identity · Hybrid Identity · Enterprise Integration",
  },
  {
    title: "Applications",
    description:
      "Application Onboarding · Identity APIs · Provisioning",
  },
  {
    title: "Governance",
    description:
      "Lifecycle Management · Access Reviews · Policy & Controls",
  },
];
---

<BaseLayout
  title="IAM Strategy & Architecture | Isocore Solutions"
  description="Enterprise IAM strategy and architecture services for scalable, secure, and maintainable identity environments."
>
  <main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="iam-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="container hero-inner">

        <div class="hero-copy">
          <Eyebrow
            variant="bracket"
            text="IAM Strategy & Architecture"
          />

          <h1>
            Identity architecture
            <span class="text-gradient">
              built for the enterprise.
            </span>
          </h1>

          <p class="hero-description">
            Design identity environments around business requirements,
            security controls, integration needs, operational realities,
            and long-term scale.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="button button-primary">
              <span>Schedule an IAM Assessment</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="hero-context">
            <span>Enterprise IAM</span>
            <span>Identity Architecture</span>
            <span>Cloud & Hybrid</span>
          </div>
        </div>

        <div class="hero-architecture" aria-hidden="true">
          <div class="architecture-header">
            <span>IDENTITY ARCHITECTURE</span>
            <span>ENTERPRISE CONTEXT</span>
          </div>

          <div class="architecture-canvas">
            <div class="architecture-grid"></div>

            <div class="architecture-ring ring-large"></div>
            <div class="architecture-ring ring-medium"></div>
            <div class="architecture-ring ring-small"></div>

            <div class="architecture-axis axis-horizontal"></div>
            <div class="architecture-axis axis-vertical"></div>

            <div class="architecture-node node-top">
              <span></span>
            </div>

            <div class="architecture-node node-left">
              <span></span>
            </div>

            <div class="architecture-node node-center">
              <span></span>
            </div>

            <div class="architecture-node node-right">
              <span></span>
            </div>

            <div class="architecture-node node-bottom">
              <span></span>
            </div>

            <span class="architecture-label label-top">
              IDENTITY
            </span>

            <span class="architecture-label label-left">
              ACCESS
            </span>

            <span class="architecture-label label-right">
              PLATFORMS
            </span>

            <span class="architecture-label label-bottom">
              ENTERPRISE
            </span>

            <div class="architecture-note">
              <span></span>
              Architecture before complexity
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- =====================================================
         PERSPECTIVE
    ====================================================== -->

    <section class="section perspective-section">
      <div class="container">

        <div class="section-header perspective-header">
          <Eyebrow
            variant="bracket"
            text="Architecture Perspective"
          />

          <h2>
            Build the foundation
            <span class="text-gradient">
              before the complexity.
            </span>
          </h2>
        </div>

        <div class="perspective-layout">

          <div class="perspective-lead">
            <p>
              Enterprise identity decisions have consequences across
              applications, infrastructure, security, operations,
              and the employee experience.
            </p>
          </div>

          <div class="perspective-copy">
            <p>
              We help organizations establish a clear identity
              architecture before individual platforms, integrations,
              and migration projects begin to drive the design.
            </p>

            <p>
              The result is an identity environment with defined
              architectural boundaries, integration patterns,
              governance considerations, and a practical path
              from the current state to the target state.
            </p>
          </div>

        </div>

        <div class="architecture-principles">

          <div class="principle">
            <span class="principle-line"></span>
            <strong>Identity</strong>
            <span>People · Workloads · Credentials</span>
          </div>

          <div class="principle">
            <span class="principle-line"></span>
            <strong>Access</strong>
            <span>Authentication · Authorization · Policy</span>
          </div>

          <div class="principle">
            <span class="principle-line"></span>
            <strong>Platforms</strong>
            <span>Directories · Applications · Cloud</span>
          </div>

          <div class="principle">
            <span class="principle-line"></span>
            <strong>Enterprise</strong>
            <span>Operations · Governance · Continuity</span>
          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================
         CAPABILITIES
    ====================================================== -->

    <section class="section capabilities-section">
      <div class="container">

        <div class="section-header capabilities-header">
          <Eyebrow
            variant="bracket"
            text="Capabilities"
          />

          <h2>
            Architecture that connects
            <span class="text-gradient">
              the identity ecosystem.
            </span>
          </h2>
        </div>

        <div class="capability-grid">

          {capabilities.map((capability) => (
            <article class="capability-card">

              <div class="capability-top">
                <span class="capability-tag">
                  {capability.tag}
                </span>

                <span
                  class="capability-marker"
                  aria-hidden="true"
                ></span>
              </div>

              <h3>{capability.title}</h3>

              <p>{capability.description}</p>

              <div class="capability-footer">
                <span>Identity Engineering</span>
                <span aria-hidden="true">→</span>
              </div>

            </article>
          ))}

        </div>

      </div>
    </section>


    <!-- =====================================================
         APPROACH
    ====================================================== -->

    <section class="section approach-section">
      <div class="container">

        <div class="approach-layout">

          <div class="approach-intro">
            <Eyebrow
              variant="bracket"
              text="How We Approach It"
            />

            <h2>
              Architecture grounded
              <span class="text-gradient">
                in reality.
              </span>
            </h2>

            <p>
              Good identity architecture accounts for more than
              technology. It has to work within the organization's
              existing environment and operating model.
            </p>
          </div>

          <div class="approach-flow">

            <article class="approach-step">
              <div class="step-visual">
                <span class="step-node"></span>
              </div>

              <div class="step-content">
                <span class="step-label">
                  Current State
                </span>

                <h3>Understand the environment.</h3>

                <p>
                  Understand existing identity platforms,
                  directories, applications, integrations,
                  dependencies, and operational processes.
                </p>
              </div>
            </article>

            <article class="approach-step">
              <div class="step-visual">
                <span class="step-node"></span>
              </div>

              <div class="step-content">
                <span class="step-label">
                  Target State
                </span>

                <h3>Define the architecture.</h3>

                <p>
                  Define the desired identity architecture,
                  capabilities, integration patterns, and
                  operating model.
                </p>
              </div>
            </article>

            <article class="approach-step">
              <div class="step-visual">
                <span class="step-node"></span>
              </div>

              <div class="step-content">
                <span class="step-label">
                  Transition
                </span>

                <h3>Establish the path forward.</h3>

                <p>
                  Establish a practical roadmap that moves
                  from the current environment toward the target
                  architecture without unnecessary disruption.
                </p>
              </div>
            </article>

          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================
         TECHNOLOGY
    ====================================================== -->

    <section class="section technology-section">
      <div class="container">

        <div class="section-header technology-header">
          <Eyebrow
            variant="bracket"
            text="Technology Context"
          />

          <h2>
            Designed across
            <span class="text-gradient">
              the enterprise stack.
            </span>
          </h2>

          <p>
            IAM architecture must account for the systems
            surrounding identity—not just the identity platform itself.
          </p>
        </div>

        <div class="technology-grid">

          {technologyGroups.map((group) => (
            <article class="technology-card">

              <div class="technology-card-top">
                <span class="technology-dot"></span>
                <span>{group.title}</span>
              </div>

              <p>{group.description}</p>

            </article>
          ))}

        </div>

      </div>
    </section>


    <!-- =====================================================
         DARK ARCHITECTURE PERSPECTIVE
    ====================================================== -->

    <section class="section-dark architecture-section">
      <div class="container">

        <div class="architecture-layout">

          <div class="architecture-copy">

            <Eyebrow
              variant="bracket"
              text="Enterprise Perspective"
            />

            <h2>
              Start with the
              <span>architecture.</span>
            </h2>

            <p>
              Whether you are defining a new IAM strategy,
              modernizing an existing environment, or preparing
              for a major identity initiative, Isocore can help
              establish the architectural foundation.
            </p>

            <a
              href="/contact"
              class="button button-primary"
            >
              <span>Schedule an IAM Assessment</span>
              <span aria-hidden="true">→</span>
            </a>

          </div>


          <div class="architecture-map" aria-hidden="true">

            <div class="map-grid"></div>

            <div class="map-axis map-axis-horizontal"></div>
            <div class="map-axis map-axis-vertical"></div>

            <div class="map-layer map-identity">
              <span>IDENTITY</span>
              <small>
                People · Workloads · Credentials
              </small>
            </div>

            <div class="map-layer map-access">
              <span>ACCESS</span>
              <small>
                Authentication · Authorization · Policy
              </small>
            </div>

            <div class="map-layer map-platforms">
              <span>PLATFORMS</span>
              <small>
                Directories · Applications · Cloud
              </small>
            </div>

            <div class="map-layer map-enterprise">
              <span>ENTERPRISE</span>
              <small>
                Operations · Governance · Continuity
              </small>
            </div>

            <div class="map-core">
              <span></span>
            </div>

          </div>

        </div>

      </div>
    </section>


    

  </main>
</BaseLayout>


<style>
  /* =========================================================
     HERO
  ========================================================= */

  .iam-hero {
    position: relative;
    overflow: hidden;
    min-height: 640px;

    display: flex;
    align-items: center;

    background:
      radial-gradient(
        circle at 82% 42%,
        rgba(0, 180, 219, 0.075),
        transparent 29%
      ),
      var(--color-bg);

    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    position: absolute;
    inset: 0;

    opacity: 0.42;

    background-image:
      linear-gradient(
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      );

    background-size: 64px 64px;

    mask-image: linear-gradient(
      90deg,
      black,
      transparent 90%
    );

    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -160px;
    top: 15%;

    border-radius: 50%;

    background: var(--color-cyan);
    opacity: 0.045;
    filter: blur(100px);

    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(360px, 0.72fr);

    gap: clamp(50px, 8vw, 100px);

    align-items: center;

    padding-block: 105px 90px;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-copy h1 {
    margin: 0 0 25px;

    font-size: clamp(3rem, 5.5vw, 5.15rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 650px;
    margin: 0;

    font-size: 1rem;
    line-height: 1.8;
  }

  .hero-actions {
    margin-top: 32px;
  }

  .hero-context {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;

    margin-top: 27px;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-context span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-context span::before {
    content: "";

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: var(--color-cyan);
  }


  /* =========================================================
     HERO ARCHITECTURE VISUAL
  ========================================================= */

  .hero-architecture {
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-card);
  }

  .architecture-header {
    min-height: 44px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding-inline: 17px;

    border-bottom: 1px solid var(--color-border);

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .architecture-header span:last-child {
    color: var(--color-primary);
  }

  .architecture-canvas {
    position: relative;
    min-height: 385px;
    overflow: hidden;
  }

  .architecture-grid {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(
        rgba(6, 20, 38, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(6, 20, 38, 0.035) 1px,
        transparent 1px
      );

    background-size: 30px 30px;
  }

  .architecture-ring {
    position: absolute;

    top: 50%;
    left: 50%;

    border: 1px solid rgba(0, 114, 255, 0.11);
    border-radius: 50%;

    transform: translate(-50%, -50%);
  }

  .ring-large {
    width: 275px;
    height: 275px;
  }

  .ring-medium {
    width: 195px;
    height: 195px;

    border-color: rgba(0, 180, 219, 0.14);
  }

  .ring-small {
    width: 105px;
    height: 105px;
  }

  .architecture-axis {
    position: absolute;

    background: rgba(0, 180, 219, 0.17);
  }

  .axis-horizontal {
    top: 50%;
    left: 15%;
    width: 70%;
    height: 1px;
  }

  .axis-vertical {
    top: 15%;
    left: 50%;
    width: 1px;
    height: 70%;
  }

  .architecture-node {
    position: absolute;
    z-index: 2;

    width: 12px;
    height: 12px;

    border: 1px solid rgba(0, 114, 255, 0.55);
    background: var(--color-bg);
  }

  .architecture-node span {
    position: absolute;
    inset: 3px;
    background: var(--color-primary);
  }

  .node-top {
    top: 15%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .node-left {
    top: 50%;
    left: 15%;
    transform: translate(-50%, -50%);
  }

  .node-center {
    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    box-shadow:
      0 0 0 8px rgba(0, 114, 255, 0.05);
  }

  .node-right {
    top: 50%;
    left: 85%;
    transform: translate(-50%, -50%);
  }

  .node-bottom {
    top: 85%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .architecture-label {
    position: absolute;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.47rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .label-top {
    top: 9%;
    left: 50%;
    transform: translateX(-50%);
  }

  .label-left {
    top: 50%;
    left: 5%;
    transform: translateY(-50%);
  }

  .label-right {
    top: 50%;
    right: 4%;
    transform: translateY(-50%);
  }

  .label-bottom {
    bottom: 9%;
    left: 50%;
    transform: translateX(-50%);
  }

  .architecture-note {
    position: absolute;

    right: 16px;
    bottom: 14px;

    display: flex;
    align-items: center;
    gap: 7px;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .architecture-note span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-cyan);
  }


  /* =========================================================
     PERSPECTIVE
  ========================================================= */

  .perspective-section {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .perspective-header {
    max-width: 780px;
  }

  .perspective-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap: clamp(40px, 8vw, 105px);

    margin-top: 55px;
    padding-top: 38px;

    border-top: 1px solid var(--color-border);
  }

  .perspective-lead p {
    margin: 0;

    color: var(--color-text);

    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }

  .perspective-copy p {
    margin: 0 0 20px;

    font-size: 0.9rem;
    line-height: 1.8;
  }

  .perspective-copy p:last-child {
    margin-bottom: 0;
  }

  .architecture-principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    margin-top: 65px;

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .principle {
    min-height: 150px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 24px;

    border-right: 1px solid var(--color-border);
  }

  .principle:last-child {
    border-right: 0;
  }

  .principle-line {
    width: 25px;
    height: 2px;

    margin-bottom: 20px;

    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .principle strong {
    margin-bottom: 7px;

    font-family: var(--font-display);
    font-size: 1rem;
  }

  .principle > span:last-child {
    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1.5;
  }


  /* =========================================================
     CAPABILITIES
  ========================================================= */

  .capabilities-section {
    background: var(--color-bg);
  }

  .capabilities-header {
    max-width: 780px;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 16px;

    margin-top: 55px;
  }

  .capability-card {
    position: relative;

    display: flex;
    flex-direction: column;

    min-height: 285px;

    overflow: hidden;

    border: 1px solid var(--color-border);

    background: var(--color-surface);

    transition:
      transform var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .capability-card:hover {
    transform: translateY(-4px);

    border-color: var(--color-border-strong);

    box-shadow: var(--shadow-card-hover);
  }

  .capability-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 22px 24px 0;
  }

  .capability-tag {
    color: var(--color-primary);

    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .capability-marker {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 0 5px rgba(0, 180, 219, 0.06);
  }

  .capability-card h3 {
    margin: 26px 24px 12px;

    font-size: 1.25rem;
    line-height: 1.2;
  }

  .capability-card p {
    margin: 0 24px;

    font-size: 0.82rem;
    line-height: 1.72;
  }

  .capability-footer {
    margin-top: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 45px;

    padding-inline: 18px;

    border-top: 1px solid var(--color-border);

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.49rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .capability-footer span:last-child {
    color: var(--color-primary);

    font-family: var(--font-sans);
    font-size: 0.9rem;

    transition: transform var(--transition-fast);
  }

  .capability-card:hover .capability-footer span:last-child {
    transform: translateX(4px);
  }


  /* =========================================================
     APPROACH
  ========================================================= */

  .approach-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .approach-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap: clamp(50px, 9vw, 115px);
  }

  .approach-intro {
    max-width: 520px;
  }

  .approach-intro h2 {
    margin: 0 0 22px;
  }

  .approach-intro p {
    margin: 0;

