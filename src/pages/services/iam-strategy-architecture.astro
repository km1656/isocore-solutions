---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CTASection from "../../components/CTASection.astro";
---

<BaseLayout
  title="IAM Strategy & Architecture | Isocore Solutions"
  description="Enterprise IAM strategy and architecture services for scalable, secure, and maintainable identity environments."
>
  <main>

    <!-- HERO -->
    <section class="service-hero">
      <div class="service-grid" aria-hidden="true"></div>
      <div class="service-glow" aria-hidden="true"></div>

      <div class="service-hero-inner">
        <div class="service-hero-copy">

          <Eyebrow
            variant="bracket"
            text="IAM Strategy & Architecture"
          />

          <h1>
            Identity architecture <span class="text-gradient"> built for the enterprise.
            </span>
          </h1>

          <p class="service-hero-description">
            Design identity environments around business requirements,
            security controls, integration needs, operational realities,
            and long-term scale.
          </p>

          <div class="service-actions">
            <a
              href="/contact"
              class="service-button service-button-primary"
            >
              <span>Schedule an IAM Assessment</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>

        <div class="service-hero-context">

          <span class="context-label">
            Enterprise IAM
          </span>

          <div class="context-line"></div>

          <p>
            Strategy and architecture across identity,
            access, directories, applications, cloud,
            governance, and security.
          </p>

        </div>
      </div>
    </section>


    <!-- OVERVIEW -->
    <section class="service-overview section">
      <div class="service-overview-inner">

        <div class="section-header">
          <Eyebrow
            variant="bracket"
            text="What We Solve"
          />

          <h2>
            Build the foundation 
            <span class="text-gradient"> before the complexity.
            </span>
          </h2>
        </div>

        <div class="overview-content">

          <div class="overview-lead">
            <p>
              Enterprise identity decisions have consequences across
              applications, infrastructure, security, operations,
              and the employee experience.
            </p>
          </div>

          <div class="overview-copy">
            <p>
              We help organizations establish a clear identity
              architecture before individual platforms, integrations,
              and migration projects begin to drive the design.
            </p>

            <p>
              The result is an identity environment with defined
              architectural boundaries, integration patterns,
              governance considerations, and a practical path
              from the current state to the target state.
            </p>
          </div>

        </div>
      </div>
    </section>


    <!-- CAPABILITIES -->
    <section class="service-capabilities">
      <div class="capabilities-inner">

        <div class="section-header">
          <Eyebrow
            variant="bracket"
            text="Capabilities"
          />

          <h2>
            Architecture that connects
            <span class="text-gradient"> the identity ecosystem.
            </span>
          </h2>
        </div>

        <div class="capability-list">

          <article class="capability-row">
            <div class="capability-title">
              <h3>Enterprise IAM Architecture</h3>
            </div>

            <div class="capability-description">
              <p>
                Define identity architecture across authentication,
                authorization, directories, governance, applications,
                infrastructure, and security controls.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-title">
              <h3>Identity Strategy & Roadmaps</h3>
            </div>

            <div class="capability-description">
              <p>
                Establish practical identity strategies and
                modernization roadmaps aligned with business
                priorities, technology direction, and operational
                requirements.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-title">
              <h3>Platform Architecture</h3>
            </div>

            <div class="capability-description">
              <p>
                Evaluate and architect IAM platforms within the
                broader enterprise environment, including integration,
                scalability, resilience, and operational considerations.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-title">
              <h3>Access Management Architecture</h3>
            </div>

            <div class="capability-description">
              <p>
                Design access patterns covering authentication,
                single sign-on, federation, MFA, authorization,
                and application access.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-title">
              <h3>Identity Governance Architecture</h3>
            </div>

            <div class="capability-description">
              <p>
                Establish governance models for identity lifecycle,
                access certification, provisioning, policy enforcement,
                and accountability.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-title">
              <h3>Cloud & Hybrid Identity Strategy</h3>
            </div>

            <div class="capability-description">
              <p>
                Architect identity environments that span cloud,
                on-premises infrastructure, directories, applications,
                and hybrid operating models.
              </p>
            </div>
          </article>

        </div>
      </div>
    </section>


    <!-- APPROACH -->
    <section class="service-approach">
      <div class="approach-inner">

        <div class="approach-intro">

          <Eyebrow
            variant="bracket"
            text="How We Approach It"
          />

          <h2>
            Architecture grounded
            <span class="text-gradient">
               in reality.
            </span>
          </h2>

          <p>
            Good identity architecture accounts for more than
            technology. It has to work within the organization's
            existing environment and operating model.
          </p>

        </div>

        <div class="approach-list">

          <div class="approach-item">
            <span class="approach-label">
              Current State
            </span>

            <p>
              Understand existing identity platforms,
              directories, applications, integrations,
              dependencies, and operational processes.
            </p>
          </div>

          <div class="approach-item">
            <span class="approach-label">
              Target State
            </span>

            <p>
              Define the desired identity architecture,
              capabilities, integration patterns, and
              operating model.
            </p>
          </div>

          <div class="approach-item">
            <span class="approach-label">
              Transition
            </span>

            <p>
              Establish a practical roadmap that moves
              from the current environment toward the target
              architecture without unnecessary disruption.
            </p>
          </div>

        </div>
      </div>
    </section>


    <!-- TECHNOLOGY -->
    <section class="service-technology section">
      <div class="technology-inner">

        <div class="section-header">
          <Eyebrow
            variant="bracket"
            text="Technology Context"
          />

          <h2>
            Designed across
            <span class="text-gradient">
                the enterprise stack.
            </span>
          </h2>

          <p>
            IAM architecture must account for the systems
            surrounding identity—not just the identity platform itself.
          </p>
        </div>

        <div class="technology-grid">

          <div class="technology-group">
            <span>Identity</span>
            <p>
              IAM Platforms · Access Management ·
              Identity Governance
            </p>
          </div>

          <div class="technology-group">
            <span>Directories</span>
            <p>
              Active Directory · LDAP · Directory Services
            </p>
          </div>

          <div class="technology-group">
            <span>Authentication</span>
            <p>
              SSO · MFA · Federation · Adaptive Access
            </p>
          </div>

          <div class="technology-group">
            <span>Cloud & Hybrid</span>
            <p>
              Cloud Identity · Hybrid Identity ·
              Enterprise Integration
            </p>
          </div>

          <div class="technology-group">
            <span>Applications</span>
            <p>
              Application Onboarding · Identity APIs ·
              Provisioning
            </p>
          </div>

          <div class="technology-group">
            <span>Governance</span>
            <p>
              Lifecycle Management · Access Reviews ·
              Policy & Controls
            </p>
          </div>

        </div>
      </div>
    </section>


    <!-- ENGAGEMENT -->
    <section class="service-engagement">
      <div class="engagement-inner">

        <div class="engagement-copy">
          <Eyebrow
            variant="bracket"
            text="Engagement"
          />

          <h2>
            Start with the
            <span class="text-gradient">
              architecture.
            </span>
          </h2>

          <p>
            Whether you are defining a new IAM strategy,
            modernizing an existing environment, or preparing
            for a major identity initiative, Isocore can help
            establish the architectural foundation.
          </p>
        </div>

        <div class="engagement-actions">

          <a
            href="/contact"
            class="service-button service-button-primary"
          >
            <span>Schedule an IAM Assessment</span>
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="/services"
            class="service-button service-button-secondary"
          >
            Explore All Services
          </a>

        </div>

      </div>
    </section>


    <CTASection />

  </main>
</BaseLayout>


<style>

  /* =================================
     HERO
     ================================= */

  .service-hero {
    position: relative;
    min-height: 610px;

    display: flex;
    align-items: center;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 78% 42%,
        rgba(0, 180, 219, 0.075),
        transparent 30%
      ),
      radial-gradient(
        circle at 20% 80%,
        rgba(0, 114, 255, 0.045),
        transparent 30%
      ),
      var(--color-bg);
  }

  .service-grid {
    position: absolute;
    inset: 0;

    opacity: 0.3;

    background-image:
      linear-gradient(
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 114, 255, 0.035) 1px,
        transparent 1px
      );

    background-size: 72px 72px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 90%
      );
  }

  .service-glow {
    position: absolute;

    width: 500px;
    height: 500px;

    right: -180px;
    top: 10%;

    border-radius: 50%;

    background: var(--color-cyan);

    opacity: 0.05;

    filter: blur(110px);

    pointer-events: none;
  }

  .service-hero-inner {
    position: relative;
    z-index: 2;

    width: min(
      1200px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(260px, 0.42fr);

    gap: 100px;

    align-items: end;

    padding-block: 125px 90px;
  }

  .service-hero-copy {
    max-width: 760px;
  }

  .service-hero h1 {
    margin: 0 0 28px;

    font-size: clamp(
      3.25rem,
      5.7vw,
      5rem
    );

    line-height: 1;
    letter-spacing: -0.055em;
  }

  .service-hero-description {
    max-width: 650px;

    margin: 0;

    color: var(--color-text-secondary);

    font-size: 1rem;
    line-height: 1.8;
  }

  .service-actions {
    margin-top: 32px;
  }

  .service-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 16px;

    min-height: 48px;

    padding: 0 18px;

    border-radius: var(--radius-sm);

    font-size: 0.82rem;
    font-weight: 700;

    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .service-button-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .service-button-primary:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .service-button-secondary {
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    background: transparent;
  }

  .service-button-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .service-hero-context {
    padding-left: 26px;

    border-left: 1px solid var(--color-border-strong);
  }

  .context-label {
    color: var(--color-primary);

    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .context-line {
    width: 36px;
    height: 1px;

    margin-block: 17px;

    background:
      linear-gradient(
        90deg,
        var(--color-primary),
        var(--color-cyan)
      );
  }

  .service-hero-context p {
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.83rem;
    line-height: 1.7;
  }


  /* =================================
     OVERVIEW
     ================================= */

  .service-overview {
    background: var(--color-white);

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .service-overview-inner {
    width: min(
      1200px,
      calc(100% - 48px)
    );

    margin-inline: auto;
  }

  .service-overview .section-header {
    max-width: 780px;
  }

  .service-overview h2,
  .service-capabilities h2,
  .service-technology h2 {
    margin-bottom: 0;
  }

  .overview-content {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap: 100px;

    margin-top: 58px;

    padding-top: 42px;

    border-top: 1px solid var(--color-border);
  }

  .overview-lead p {
    margin: 0;

    color: var(--color-text);

    font-family: var(--font-display);

    font-size: 1.35rem;
    font-weight: 650;

    line-height: 1.5;

    letter-spacing: -0.025em;
  }

  .overview-copy p {
    margin: 0 0 20px;

    color: var(--color-text-secondary);

    font-size: 0.94rem;

    line-height: 1.8;
  }

  .overview-copy p:last-child {
    margin-bottom: 0;
  }


  /* =================================
     CAPABILITIES
     ================================= */

  .service-capabilities {
    padding-block: 120px;

    background: var(--color-bg);
  }

  .capabilities-inner {
    width: min(
      1200px,
      calc(100% - 48px)
    );

    margin-inline: auto;
  }

  .capability-list {
    margin-top: 58px;

    border-top: 1px solid var(--color-border);
  }

  .capability-row {
    display: grid;

    grid-template-columns:
      minmax(260px, 0.7fr)
      minmax(0, 1.3fr);

    gap: 80px;

    padding-block: 32px 34px;

    border-bottom: 1px solid var(--color-border);

    transition:
      background var(--transition-normal),
      padding-left var(--transition-normal),
      padding-right var(--transition-normal);
  }

  .capability-row:hover {
    background: var(--color-surface-raised);

    padding-left: 18px;
    padding-right: 18px;
  }

  .capability-title h3 {
    margin: 0;

    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .capability-description p {
    max-width: 620px;

    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.88rem;

    line-height: 1.75;
  }


  /* =================================
     APPROACH
     ================================= */

  .service-approach {
    padding-block: 120px;

    background: var(--color-white);

    border-top: 1px solid var(--color-border);
  }

  .approach-inner {
    width: min(
      1200px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: grid;

    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, 1.2fr);

    gap: 110px;
  }

  .approach-intro {
    max-width: 520px;
  }

  .approach-intro h2 {
    margin: 0 0 24px;

    font-size: clamp(
      2.4rem,
      4vw,
      3.6rem
    );
  }

  .approach-intro p {
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.94rem;

    line-height: 1.8;
  }

  .approach-list {
    border-top: 1px solid var(--color-border);
  }

  .approach-item {
    padding-block: 28px 30px;

    border-bottom: 1px solid var(--color-border);
  }

  .approach-label {
    display: block;

    margin-bottom: 10px;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: 0.62rem;
    font-weight: 700;

    letter-spacing: 0.11em;

    text-transform: uppercase;
  }

  .approach-item p {
    max-width: 620px;

    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.88rem;

    line-height: 1.75;
  }


  /* =================================
     TECHNOLOGY
     ================================= */

  .service-technology {
    background: var(--color-bg);
  }

  .technology-inner {
    width: min(
      1200px,
      calc(100% - 48px)
    );

    margin-inline: auto;
  }

  .technology-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    margin-top: 58px;

    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .technology-group {
    min-height: 155px;

    padding: 30px;

    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .technology-group span {
    display: block;

    margin-bottom: 12px;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: 0.62rem;
    font-weight: 700;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .technology-group p {
    max-width: 480px;

    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.84rem;

    line-height: 1.7;
  }


  /* =================================
     ENGAGEMENT
     ================================= */

  .service-engagement {
    padding-block: 100px;

    background: var(--color-white);

    border-top: 1px solid var(--color-border);
  }

  .engagement-inner {
    width: min(
      1200px,
      calc(100% - 48px)
    );

    margin-inline: auto;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 60px;
  }

  .engagement-copy {
    max-width: 650px;
  }

  .engagement-copy h2 {
    margin: 0 0 20px;

    font-size: clamp(
      2.3rem,
      4vw,
      3.5rem
    );
  }

  .engagement-copy p {
    max-width: 620px;

    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.94rem;

    line-height: 1.8;
  }

  .engagement-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 12px;

    flex-shrink: 0;
  }


  /* =================================
     RESPONSIVE
     ================================= */

  @media (max-width: 1000px) {

    .service-hero-inner {
      grid-template-columns: 1fr;

      gap: 55px;
    }

    .service-hero-context {
      max-width: 520px;
    }

    .overview-content,
    .approach-inner {
      grid-template-columns: 1fr;

      gap: 50px;
    }

    .engagement-inner {
      align-items: flex-start;

      flex-direction: column;
    }
  }


  @media (max-width: 768px) {

    .service-hero-inner {
      width: calc(100% - 40px);

      padding-block: 105px 75px;
    }

    .service-hero h1 {
      font-size: clamp(
        2.9rem,
        11vw,
        4rem
      );
    }

    .service-capabilities,
    .service-approach {
      padding-block: 88px;
    }

    .service-overview-inner,
    .capabilities-inner,
    .technology-inner,
    .engagement-inner,
    .approach-inner {
      width: calc(100% - 40px);
    }

    .capability-row {
      grid-template-columns: 1fr;

      gap: 14px;

      padding-block: 26px 28px;
    }

    .capability-row:hover {
      padding-left: 12px;
      padding-right: 12px;
    }

    .technology-grid {
      grid-template-columns: 1fr;
    }

    .technology-group {
      min-height: auto;
    }

    .service-engagement {
      padding-block: 80px;
    }

    .engagement-actions {
      width: 100%;
    }

    .engagement-actions .service-button {
      width: 100%;
    }
  }


  @media (max-width: 500px) {

    .service-hero-inner,
    .service-overview-inner,
    .capabilities-inner,
    .technology-inner,
    .engagement-inner,
    .approach-inner {
      width: calc(100% - 32px);
    }

    .service-hero-inner {
      padding-block: 92px 65px;
    }

    .service-hero-context {
      padding-left: 20px;
    }

    .technology-group {
      padding: 24px;
    }
  }

</style>