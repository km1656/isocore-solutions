---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Eyebrow from "../../components/Eyebrow.astro";
---

<BaseLayout
  title="Managed Identity & Support | Isocore Solutions"
  description="Keep enterprise identity infrastructure resilient with IAM platform support, directory operations, troubleshooting, optimization, and continuous improvement."
>
  <main>
    <!-- HERO -->
    <section class="service-hero">
      <div class="hero-grid"></div>

      <div class="container hero-inner">
        <div class="hero-content">
          <Eyebrow text="Managed Identity & Support" variant="bracket" />

          <h1>
            Keep identity infrastructure
            <span class="text-gradient">resilient and reliable.</span>
          </h1>

          <p class="hero-description">
            Provide the engineering expertise, operational support, and ongoing
            optimization required to keep enterprise identity environments
            reliable and adaptable.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="button button-primary">
              Schedule an IAM Assessment
              <span>→</span>
            </a>

            <a href="/services" class="button button-secondary">
              Explore All Services
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT WE SOLVE -->
    <section class="section solve-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="What We Solve" variant="system" />

          <h2>Identity requires ongoing engineering.</h2>

          <p>
            Identity environments continue to evolve after implementation.
            Applications change, integrations expand, platforms are updated,
            and operational issues emerge. We provide the technical expertise
            required to keep identity reliable over time.
          </p>
        </div>

        <div class="solve-grid">
          <div class="solve-item">
            <h3>IAM Platform Operations</h3>
            <p>
              Support identity platforms, configurations, integrations, and
              operational requirements across the enterprise.
            </p>
          </div>

          <div class="solve-item">
            <h3>Directory Operations</h3>
            <p>
              Support Active Directory and related identity infrastructure
              required for enterprise authentication and access.
            </p>
          </div>

          <div class="solve-item">
            <h3>Troubleshooting & Incident Support</h3>
            <p>
              Diagnose identity issues across authentication, access,
              provisioning, synchronization, and application integrations.
            </p>
          </div>

          <div class="solve-item">
            <h3>Performance & Configuration</h3>
            <p>
              Review identity configurations, integrations, and operational
              patterns to improve reliability and maintainability.
            </p>
          </div>

          <div class="solve-item">
            <h3>Identity Governance Support</h3>
            <p>
              Support identity lifecycle, access controls, certification
              processes, policies, and governance requirements.
            </p>
          </div>

          <div class="solve-item">
            <h3>Continuous Improvement</h3>
            <p>
              Identify opportunities to improve architecture, automation,
              operational efficiency, and platform capabilities.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="section capabilities-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="Capabilities" variant="line" />

          <h2>Engineering support beyond implementation.</h2>
        </div>

        <div class="capabilities-list">
          <article class="capability-row">
            <div class="capability-content">
              <h3>IAM Platform Support</h3>
              <p>
                Provide ongoing technical expertise for IAM platforms,
                configurations, integrations, and operational requirements.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Directory Operations</h3>
              <p>
                Support enterprise directory environments, including Active
                Directory and related identity infrastructure.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Identity Troubleshooting</h3>
              <p>
                Diagnose authentication, access, provisioning, synchronization,
                and integration issues across complex identity environments.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Platform Optimization</h3>
              <p>
                Review configurations, integrations, processes, and operational
                patterns to improve reliability and maintainability.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Governance Support</h3>
              <p>
                Support identity lifecycle, access controls, certification
                processes, policy implementation, and governance requirements.
              </p>
            </div>
          </article>

          <article class="capability-row">
            <div class="capability-content">
              <h3>Continuous Improvement</h3>
              <p>
                Identify opportunities to improve identity architecture,
                automation, operational efficiency, and platform capabilities
                over time.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section class="section approach-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="How We Approach It" variant="path" />

          <h2>Operate. Stabilize. Improve.</h2>

          <p>
            Ongoing identity support should do more than resolve individual
            issues. We work to understand recurring problems, stabilize the
            environment, and improve the underlying platform over time.
          </p>
        </div>

        <div class="approach-grid">
          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Operate</h3>
            <p>
              Provide practical technical support across identity platforms,
              directories, integrations, authentication systems, and
              infrastructure.
            </p>
          </article>

          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Stabilize</h3>
            <p>
              Identify recurring issues, operational gaps, configuration
              problems, and integration dependencies affecting reliability.
            </p>
          </article>

          <article class="approach-card">
            <span class="approach-line"></span>
            <h3>Improve</h3>
            <p>
              Continuously optimize identity architecture, automation,
              operational efficiency, and platform capabilities as needs
              evolve.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="section technology-section">
      <div class="container">
        <div class="section-header">
          <Eyebrow text="Technology Context" variant="signal" />

          <h2>Support across the identity ecosystem.</h2>

          <p>
            Identity operations span platforms, infrastructure, applications,
            authentication services, and cloud environments. Support needs to
            account for the entire ecosystem.
          </p>
        </div>

        <div class="technology-grid">
          <div class="technology-card">
            <span>01</span>
            <h3>IAM Platforms</h3>
            <p>
              Identity platforms, configurations, policies, integrations, and
              operational services.
            </p>
          </div>

          <div class="technology-card">
            <span>02</span>
            <h3>Directories</h3>
            <p>
              Active Directory, directory services, identity stores,
              synchronization, and related infrastructure.
            </p>
          </div>

          <div class="technology-card">
            <span>03</span>
            <h3>Authentication</h3>
            <p>
              Authentication services, SSO, MFA, federation, and access
              controls.
            </p>
          </div>

          <div class="technology-card">
            <span>04</span>
            <h3>Applications</h3>
            <p>
              Application integrations, authentication dependencies, access
              issues, and identity lifecycle connections.
            </p>
          </div>

          <div class="technology-card">
            <span>05</span>
            <h3>Cloud & Hybrid</h3>
            <p>
              Cloud identity services and hybrid environments connecting
              on-premises and cloud infrastructure.
            </p>
          </div>

          <div class="technology-card">
            <span>06</span>
            <h3>Operations</h3>
            <p>
              Monitoring, troubleshooting, configuration management, incident
              response, and continuous improvement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ENGAGEMENT -->
    <section class="section engagement-section">
      <div class="container">
        <div class="engagement-panel">
          <div class="engagement-content">
            <Eyebrow text="Engagement" variant="bracket" />

            <h2>Identity doesn't stop at implementation.</h2>

            <p>
              Whether you need ongoing IAM expertise, additional operational
              capacity, platform support, or help stabilizing a complex
              identity environment, Isocore can provide the engineering support
              required to keep identity moving forward.
            </p>

            <div class="engagement-actions">
              <a href="/contact" class="button button-primary">
                Schedule an IAM Assessment
                <span>→</span>
              </a>

              <a href="/services" class="button button-secondary">
                Explore All Services
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: center;
    padding-top: 150px;
    padding-bottom: 110px;
    background: var(--color-bg);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(0, 114, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 114, 255, 0.055) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 880px;
  }

  .hero-content :global(.eyebrow-bracket) {
    color: var(--color-cyan);
  }

  .hero-content :global(.eyebrow-bracket + span) {
    color: var(--color-primary);
  }

  .hero-content h1 {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .hero-description {
    max-width: 720px;
    margin-bottom: 36px;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .hero-actions,
  .engagement-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    transition:
      background var(--transition-normal),
      border-color var(--transition-normal),
      color var(--transition-normal),
      transform var(--transition-normal);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    background: var(--color-white);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .solve-section {
    background: var(--color-white);
  }

  .section-header {
    max-width: 760px;
  }

  .solve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .solve-item {
    min-height: 230px;
    padding: 32px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .solve-item h3 {
    margin-bottom: 14px;
  }

  .solve-item p {
    margin-bottom: 0;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .capabilities-section {
    background: var(--color-bg);
  }

  .capabilities-list {
    border-top: 1px solid var(--color-border);
  }

  .capability-row {
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
    transition:
      padding-left var(--transition-normal),
      background var(--transition-normal);
  }

  .capability-row:hover {
    padding-left: 18px;
    background: rgba(0, 114, 255, 0.025);
  }

  .capability-content h3 {
    margin-bottom: 10px;
  }

  .capability-content p {
    max-width: 760px;
    margin-bottom: 0;
  }

  .approach-section {
    background: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .approach-card {
    padding: 34px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .approach-line {
    display: block;
    width: 42px;
    height: 2px;
    margin-bottom: 28px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .approach-card h3 {
    margin-bottom: 14px;
  }

  .approach-card p {
    margin-bottom: 0;
  }

  .technology-section {
    background: var(--color-bg);
  }

  .technology-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .technology-card {
    min-height: 220px;
    padding: 30px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .technology-card > span {
    display: block;
    margin-bottom: 24px;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .technology-card h3 {
    margin-bottom: 10px;
  }

  .technology-card p {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .engagement-section {
    background: var(--color-white);
  }

  .engagement-panel {
    position: relative;
    overflow: hidden;
    padding: 72px;
    background: linear-gradient(
      135deg,
      #061426 0%,
      #0a2a4a 55%,
      #006b8f 100%
    );
    color: var(--color-white);
  }

  .engagement-panel::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    right: -160px;
    top: -180px;
    border-radius: 50%;
    background: var(--color-cyan);
    opacity: 0.08;
    filter: blur(70px);
  }

  .engagement-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .engagement-content :global(.eyebrow-bracket) {
    color: rgba(255, 255, 255, 0.72);
  }

  .engagement-content :global(.eyebrow-bracket + span) {
    color: var(--color-white);
  }

  .engagement-content h2 {
    color: var(--color-white);
    margin-bottom: 22px;
  }

  .engagement-content p {
    max-width: 720px;
    margin-bottom: 32px;
    color: rgba(255, 255, 255, 0.76);
  }

  .engagement-content .button-secondary {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-white);
  }

  .engagement-content .button-secondary:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 900px) {
    .solve-grid,
    .technology-grid,
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .engagement-panel {
      padding: 52px 36px;
    }
  }

  @media (max-width: 700px) {
    .service-hero {
      min-height: auto;
      padding-top: 130px;
      padding-bottom: 80px;
    }

    .hero-description {
      font-size: 1rem;
    }

    .solve-grid,
    .technology-grid,
    .approach-grid {
      grid-template-columns: 1fr;
    }

    .solve-item,
    .technology-card {
      min-height: auto;
    }

    .engagement-panel {
      padding: 42px 24px;
    }

    .button {
      width: 100%;
    }
  }
</style>