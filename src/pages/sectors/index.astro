---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CTASection from "../../components/CTASection.astro";

const sectors = [
  {
    title: "Financial Services",
    description:
      "Identity environments where access, governance, resilience, and regulatory requirements must operate together.",
    capabilities: [
      "Workforce Identity",
      "Identity Governance",
      "Privileged Access",
      "Authentication & Federation",
    ],
  },
  {
    title: "Healthcare",
    description:
      "Identity architectures supporting complex workforces, clinical applications, hybrid infrastructure, and sensitive access requirements.",
    capabilities: [
      "Workforce Identity",
      "Application Access",
      "Privileged Access",
      "Hybrid Identity",
    ],
  },
  {
    title: "Manufacturing",
    description:
      "Identity engineering across distributed workforces, enterprise applications, operational environments, and hybrid infrastructure.",
    capabilities: [
      "Workforce Identity",
      "Directory Services",
      "Application Integration",
      "Privileged Access",
    ],
  },
  {
    title: "Technology & Software",
    description:
      "Identity foundations designed for cloud-first organizations, distributed teams, application ecosystems, and modern development environments.",
    capabilities: [
      "Cloud Identity",
      "Workforce IAM",
      "Federation",
      "Machine Identity",
    ],
  },
  {
    title: "Energy & Utilities",
    description:
      "Identity architectures built for operational continuity, distributed environments, privileged access, and complex infrastructure.",
    capabilities: [
      "Workforce Identity",
      "Privileged Access",
      "Hybrid Identity",
      "Infrastructure Access",
    ],
  },
  {
    title: "Professional & Business Services",
    description:
      "Identity environments supporting distributed workforces, client-facing applications, collaboration platforms, and changing organizational structures.",
    capabilities: [
      "Lifecycle Management",
      "Federation",
      "Application Access",
      "Identity Governance",
    ],
  },
  {
    title: "Public Sector",
    description:
      "Identity engineering for complex organizational environments where security, governance, interoperability, and operational continuity are essential.",
    capabilities: [
      "Workforce Identity",
      "Access Governance",
      "Federation",
      "Hybrid Infrastructure",
    ],
  },
];

const contextAreas = [
  {
    label: "Regulatory Context",
    text: "Identity controls must align with the regulatory, governance, and audit requirements that shape each operating environment.",
  },
  {
    label: "Operational Reality",
    text: "Architecture has to work within distributed teams, operational systems, legacy platforms, and business-critical processes.",
  },
  {
    label: "Technology Landscape",
    text: "Cloud, hybrid, on-premises, SaaS, directories, applications, and infrastructure all contribute to the identity environment.",
  },
  {
    label: "Business Continuity",
    text: "Identity services must remain reliable as organizations evolve, applications change, and access requirements expand.",
  },
];
---

<BaseLayout
  title="Sectors | Isocore Solutions"
  description="Identity engineering across complex enterprise sectors, including financial services, healthcare, manufacturing, technology, energy, professional services, and public sector organizations."
>
  <main>
    <!-- HERO -->
    <section class="sectors-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

      <div class="container hero-inner">
        <div class="hero-copy">
          <Eyebrow text="Sectors" variant="bracket" />

          <h1>
            Identity engineering across
            <span class="text-gradient"> complex enterprise sectors.</span>
          </h1>

          <p>
            Every identity environment operates within its own regulatory,
            operational, application, workforce, and infrastructure
            constraints. Isocore applies identity engineering practices to
            the realities of each sector.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="button button-primary">
              <span>Schedule an IAM Assessment</span>
              <span aria-hidden="true">→</span>
            </a>

            <a href="/services" class="button button-secondary">
              <span>Explore Services</span>
            </a>
          </div>

          <div class="hero-meta" aria-label="Identity engineering focus areas">
            <span>Regulatory environments</span>
            <span>Hybrid infrastructure</span>
            <span>Business-critical access</span>
          </div>
        </div>

        <!-- Architectural visual -->
        <div class="hero-system" aria-hidden="true">
          <div class="system-topbar">
            <span>SECTOR CONTEXT</span>
            <span>IDENTITY ARCHITECTURE</span>
          </div>

          <div class="system-canvas">
            <div class="system-grid"></div>

            <div class="system-ring ring-outer"></div>
            <div class="system-ring ring-middle"></div>
            <div class="system-ring ring-inner"></div>

            <div class="system-axis axis-horizontal"></div>
            <div class="system-axis axis-vertical"></div>

            <div class="system-node node-center">
              <span></span>
            </div>

            <div class="system-node node-top">
              <span></span>
            </div>

            <div class="system-node node-left">
              <span></span>
            </div>

            <div class="system-node node-right">
              <span></span>
            </div>

            <div class="system-node node-bottom">
              <span></span>
            </div>

            <span class="system-label label-top">IDENTITY</span>
            <span class="system-label label-left">ACCESS</span>
            <span class="system-label label-right">PLATFORMS</span>
            <span class="system-label label-bottom">ENTERPRISE</span>

            <div class="system-caption">
              <span class="caption-dot"></span>
              Environment informs architecture
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PERSPECTIVE -->
    <section class="section sector-perspective">
      <div class="container">
        <div class="section-header perspective-header">
          <Eyebrow text="Sector Perspective" variant="system" />

          <h2>
            Identity architecture must account for the
            <span class="text-gradient"> environment around it.</span>
          </h2>

          <p>
            Technology alone does not define an identity strategy. Regulatory
            requirements, operating models, application landscapes, workforce
            patterns, infrastructure, and business continuity all influence
            how identity should be designed and operated.
          </p>
        </div>

        <div class="context-grid">
          {contextAreas.map((area) => (
            <article class="context-card">
              <div class="context-line" aria-hidden="true"></div>

              <div class="context-card-inner">
                <span class="context-marker" aria-hidden="true"></span>

                <div>
                  <h3>{area.label}</h3>
                  <p>{area.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTOR EXPERTISE -->
    <section class="section sectors-list">
      <div class="container">
        <div class="section-header sector-header">
          <Eyebrow text="Sector Expertise" variant="signal" />

          <h2>
            Identity practices shaped around
            <span class="text-gradient"> your environment.</span>
          </h2>

          <p>
            Our engineering approach adapts to the operational and technical
            characteristics of the organizations we support.
          </p>
        </div>

        <div class="sector-grid">
          {sectors.map((sector, index) => (
            <article class:list={["sector-card", index === sectors.length - 1 && "sector-card-wide"]}>
              <div class="sector-card-accent" aria-hidden="true"></div>

              <div class="sector-card-content">
                <div class="sector-card-label">
                  <span class="sector-status" aria-hidden="true"></span>
                  <span>SECTOR CONTEXT</span>
                </div>

                <h3>{sector.title}</h3>

                <p>{sector.description}</p>

                <div class="sector-divider" aria-hidden="true"></div>

                <div class="capability-heading">
                  Identity considerations
                </div>

                <div class="capability-list">
                  {sector.capabilities.map((capability) => (
                    <span>{capability}</span>
                  ))}
                </div>
              </div>

              <div class="sector-card-footer">
                <span>Identity Engineering</span>
                <span class="sector-arrow" aria-hidden="true">→</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE PERSPECTIVE -->
    <section class="section section-dark architecture-section">
      <div class="container">
        <div class="architecture-layout">
          <div class="architecture-copy">
            <Eyebrow
              text="Enterprise Perspective"
              variant="bracket"
            />

            <h2>
              The sector changes.
              <span> The identity principles remain.</span>
            </h2>

            <p>
              Effective identity engineering starts with understanding the
              environment, defining the requirements, and designing an
              architecture that can evolve without compromising security or
              operational continuity.
            </p>

            <a
              href="/services/iam-strategy-architecture"
              class="button button-secondary"
            >
              <span>Explore IAM Strategy</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="architecture-map" aria-hidden="true">
            <div class="architecture-map-grid"></div>

            <div class="architecture-axis architecture-axis-h"></div>
            <div class="architecture-axis architecture-axis-v"></div>

            <div class="architecture-layer layer-identity">
              <span>IDENTITY</span>
              <small>People · Workloads · Credentials</small>
            </div>

            <div class="architecture-layer layer-access">
              <span>ACCESS</span>
              <small>Authentication · Authorization · Policy</small>
            </div>

            <div class="architecture-layer layer-platforms">
              <span>PLATFORMS</span>
              <small>Directories · Applications · Cloud</small>
            </div>

            <div class="architecture-layer layer-enterprise">
              <span>ENTERPRISE</span>
              <small>Operations · Governance · Continuity</small>
            </div>

            <div class="architecture-core">
              <span></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</BaseLayout>

<style>
  /* -------------------------------------------------------
     HERO
  ------------------------------------------------------- */

  .sectors-hero {
    position: relative;
    overflow: hidden;
    min-height: 650px;
    display: flex;
    align-items: center;
    background:
      radial-gradient(
        circle at 82% 44%,
        rgba(0, 180, 219, 0.08),
        transparent 30%
      ),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.55;
    background-image:
      linear-gradient(
        rgba(6, 20, 38, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(6, 20, 38, 0.035) 1px,
        transparent 1px
      );
    background-size: 56px 56px;
    mask-image: linear-gradient(
      90deg,
      black 0%,
      black 60%,
      transparent 100%
    );
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgba(0, 114, 255, 0.07);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-orbit-one {
    width: 680px;
    height: 680px;
    right: -240px;
    top: -120px;
  }

  .hero-orbit-two {
    width: 430px;
    height: 430px;
    right: -110px;
    top: 5px;
    border-color: rgba(0, 180, 219, 0.09);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.78fr);
    gap: 90px;
    align-items: center;
    padding-block: 105px 90px;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-copy h1 {
    max-width: 780px;
    margin-bottom: 24px;
    font-size: clamp(3.2rem, 5.6vw, 5.25rem);
    letter-spacing: -0.055em;
  }

  .hero-copy > p {
    max-width: 650px;
    margin-bottom: 32px;
    font-size: 1.03rem;
    line-height: 1.78;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 22px;
    margin-top: 28px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-meta span::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  /* -------------------------------------------------------
     HERO SYSTEM
  ------------------------------------------------------- */

  .hero-system {
    width: 100%;
    min-height: 420px;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.8);
    box-shadow: var(--shadow-card);
  }

  .system-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 46px;
    padding-inline: 18px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .system-topbar span:last-child {
    color: var(--color-primary);
  }

  .system-canvas {
    position: relative;
    min-height: 373px;
    overflow: hidden;
  }

  .system-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgba(6, 20, 38, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(6, 20, 38, 0.035) 1px,
        transparent 1px
      );
    background-size: 30px 30px;
  }

  .system-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgba(0, 114, 255, 0.12);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .ring-outer {
    width: 290px;
    height: 290px;
  }

  .ring-middle {
    width: 205px;
    height: 205px;
    border-color: rgba(0, 180, 219, 0.14);
  }

  .ring-inner {
    width: 112px;
    height: 112px;
    border-color: rgba(0, 114, 255, 0.11);
  }

  .system-axis {
    position: absolute;
    background: rgba(0, 180, 219, 0.2);
  }

  .axis-horizontal {
    top: 50%;
    left: 17%;
    width: 66%;
    height: 1px;
  }

  .axis-vertical {
    top: 17%;
    left: 50%;
    width: 1px;
    height: 66%;
  }

  .system-node {
    position: absolute;
    z-index: 2;
    width: 13px;
    height: 13px;
    border: 1px solid rgba(0, 114, 255, 0.55);
    background: var(--color-bg);
  }

  .system-node span {
    position: absolute;
    inset: 3px;
    background: var(--color-primary);
  }

  .node-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 8px rgba(0, 114, 255, 0.055);
  }

  .node-top {
    top: 17%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .node-left {
    top: 50%;
    left: 17%;
    transform: translate(-50%, -50%);
  }

  .node-right {
    top: 50%;
    left: 83%;
    transform: translate(-50%, -50%);
  }

  .node-bottom {
    top: 83%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .system-label {
    position: absolute;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.49rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .label-top {
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
  }

  .label-left {
    top: 50%;
    left: 6%;
    transform: translateY(-50%);
  }

  .label-right {
    top: 50%;
    right: 5%;
    transform: translateY(-50%);
  }

  .label-bottom {
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
  }

  .system-caption {
    position: absolute;
    right: 18px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.04em;
  }

  .caption-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  /* -------------------------------------------------------
     PERSPECTIVE
  ------------------------------------------------------- */

  .sector-perspective {
    background: var(--color-surface);
  }

  .perspective-header {
    max-width: 790px;
  }

  .context-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .context-card {
    position: relative;
    min-height: 245px;
    padding: 34px 28px;
    border-right: 1px solid var(--color-border);
  }

  .context-card:last-child {
    border-right: 0;
  }

  .context-line {
    width: 28px;
    height: 2px;
    margin-bottom: 34px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .context-card-inner {
    display: flex;
    gap: 13px;
  }

  .context-marker {
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .context-card h3 {
    margin-bottom: 11px;
    font-size: 1.18rem;
  }

  .context-card p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.72;
  }

  /* -------------------------------------------------------
     SECTOR EXPERTISE
  ------------------------------------------------------- */

  .sectors-list {
    background: var(--color-bg);
  }

  .sector-header {
    max-width: 760px;
  }

  .sector-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .sector-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 315px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition:
      border-color var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .sector-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .sector-card-wide {
    grid-column: 1 / -1;
    max-width: calc(50% - 9px);
  }

  .sector-card-accent {
    width: 100%;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-cyan)
    );
  }

  .sector-card-content {
    flex: 1;
    padding: 28px 30px 26px;
  }

  .sector-card-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .sector-status {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0 4px rgba(0, 180, 219, 0.07);
  }

  .sector-card-content h3 {
    max-width: 480px;
    margin-bottom: 12px;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }

  .sector-card-content > p {
    max-width: 570px;
    margin-bottom: 22px;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .sector-divider {
    width: 100%;
    height: 1px;
    margin-bottom: 17px;
    background: var(--color-border);
  }

  .capability-heading {
    margin-bottom: 9px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.51rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .capability-list span {
    padding: 5px 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .sector-card:hover .capability-list span {
    color: var(--color-primary);
    border-color: rgba(0, 114, 255, 0.2);
    background: rgba(0, 114, 255, 0.025);
  }

  .sector-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 46px;
    padding-inline: 20px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.51rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sector-arrow {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: transform var(--transition-fast);
  }

  .sector-card:hover .sector-arrow {
    transform: translateX(4px);
  }

  /* -------------------------------------------------------
     DARK ARCHITECTURE
  ------------------------------------------------------- */

  .architecture-section {
    overflow: hidden;
  }

  .architecture-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1fr);
    gap: 90px;
    align-items: center;
  }

  .architecture-copy {
    max-width: 610px;
  }

  .architecture-copy h2 {
    margin-bottom: 24px;
  }

  .architecture-copy h2 span {
    display: block;
    color: var(--color-cyan);
  }

  .architecture-copy p {
    margin-bottom: 30px;
    line-height: 1.8;
  }

  .architecture-map {
    position: relative;
    min-height: 450px;
    overflow: hidden;
    border: 1px solid rgba(216, 229, 239, 0.12);
    background: var(--color-dark-surface);
  }

  .architecture-map-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgba(216, 229, 239, 0.04) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(216, 229, 239, 0.04) 1px,
        transparent 1px
      );
    background-size: 34px 34px;
  }

  .architecture-axis {
    position: absolute;
    z-index: 1;
    background: rgba(0, 180, 219, 0.14);
  }

  .architecture-axis-h {
    top: 50%;
    left: 8%;
    width: 84%;
    height: 1px;
  }

  .architecture-axis-v {
    top: 10%;
    left: 50%;
    width: 1px;
    height: 80%;
  }

  .architecture-layer {
    position: absolute;
    z-index: 2;
    left: 11%;
    width: 78%;
    height: 72px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 22px;
    border: 1px solid rgba(216, 229, 239, 0.12);
